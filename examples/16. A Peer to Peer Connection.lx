// =============================================================================
// Example 16: Interactive Localhost P2P Node (Refactored)
// Description:
//   Prompts user for local and remote ports via readln and connects peers
//   over UDP on localhost (127.0.0.1) using the net.lx library.
// Dependencies:
//   - lib/io.lx, lib/fmt.lx, lib/maths.lx, lib/net.lx
// Run with: ./lx -i "examples/16. A Peer to Peer Connection.lx" "program files/lib"
// =============================================================================

main:
	movi r6 stack
	call heap_init

	// Print banner
	movi r1 prompt_banner
	call prints

	// Prompt for LOCAL listening port
	movi r1 prompt_local_port
	call prints
	movi r1 input_buf
	call readln
	call str_toi
	mov  r4 r1              // r4 = local_port

	// Prompt for REMOTE peer port
	movi r1 prompt_peer_port
	call prints
	movi r1 input_buf
	call readln
	call str_toi
	mov  r5 r1              // r5 = peer_port

	// -------------------------------------------------------------------------
	// Abstracted Network Initialization
	// -------------------------------------------------------------------------
	// 1. Open UDP Word Socket on local port (r4)
	mov  r1 r4
	call net_open_udp_word

	// 2. Set target to "localhost":peer_port (r5)
	movi r1 localhost_str
	mov  r2 r5
	call net_set_target

	movi r1 msg_ready
	call prints

	// =========================================================================
	// Main P2P Event Loop
	// =========================================================================
	.p2p_loop:
		movi r1 #500
		call sleep_ms
		// 1. Check if packet arrived from peer
		call net_rx_len
		bne  r1 r0 .receive_packet

		// 2. Poll keyboard for manual trigger (Press 'S')
		movi r2 0xFF02 // CONS_STAT
		lw   r1 [r2 + #0]
		beq  r1 r0 .throttle_vsync

		movi r2 0xFF01 // CONS_IN
		lw   r1 [r2 + #0]

		// Check 'S' (83) or 's' (115)
		movi r3 #83
		beq  r1 r3 .manual_send
		movi r3 #115
		beq  r1 r3 .manual_send

		b    .throttle_vsync

	.throttle_vsync:
		movi r2 0xFF0C
		lw   r0 [r2 + #0]
		b    .p2p_loop

	// -------------------------------------------------------------------------
	// Manual Inject
	// -------------------------------------------------------------------------
	.manual_send:
		movi r1 msg_tx_send
		call prints

		// Populate 3-word payload: [100, 200, 300]
		movi r2 payload
		movi r1 #100
		sw   r1 [r2 + #0]
		movi r1 #200
		sw   r1 [r2 + #1]
		movi r1 #300
		sw   r1 [r2 + #2]

		// Send array via library!
		movi r1 payload
		movi r2 #3
		call net_send_array

		b    .throttle_vsync

	// -------------------------------------------------------------------------
	// Packet Reception & Increment Loop
	// -------------------------------------------------------------------------
	.receive_packet:
		movi r1 msg_rx_header
		call prints

		// Wait for exactly 3 words and read them into RAM via library!
		movi r1 payload
		movi r2 #3
		call net_read_array

		// Print received numbers to console
		movi r5 payload
		movi r4 #3

	.print_loop:
		lw   r1 [r5 + #0]
		movi r2 itoa_buf
		call itoa
		call prints
		movi r1 str_space
		call prints

		addi r5 r5 1
		subi r4 r4 1
		bne  r4 r0 .print_loop

		movi r1 str_newline
		call prints

		// Increment every value by +1
		movi r2 payload
		lw   r1 [r2 + #0]
		addi r1 r1 1
		sw   r1 [r2 + #0]

		lw   r1 [r2 + #1]
		addi r1 r1 1
		sw   r1 [r2 + #1]

		lw   r1 [r2 + #2]
		addi r1 r1 1
		sw   r1 [r2 + #2]

		// Return incremented payload back to peer
		movi r1 payload
		movi r2 #3
		call net_send_array

		b    .throttle_vsync

// =============================================================================
// DATA SECTION
// =============================================================================
localhost_str:     .fill "localhost"

prompt_banner:     .fill "\n=== Pistachio P2P Interactive Node ===\n"
prompt_local_port: .fill "Enter LOCAL listening port (e.g. 9001): "
prompt_peer_port:  .fill "Enter TARGET peer port     (e.g. 9002): "
msg_ready:         .fill "[P2P] Socket bound on localhost! Press 'S' to inject packet.\n"
msg_tx_send:       .fill "[P2P] Sending packet to peer...\n"
msg_rx_header:     .fill "[P2P] Received packet: "
str_space:         .fill " "
str_newline:       .fill "\n"

input_buf:         .space 20
payload:           .space 3
itoa_buf:          .space 10

stack:             .space 100