main:
    movi r6, stack
    call heap_init

    // 1. Create a dynamic list object on the heap
    call linked_list_create
    mov  r4, r1              // r4 = myList

    // 2. Insert items: (list, data, index)
    mov  r1, r4
    movi r2, #30
    movi r3, #0
    call linked_list_insert_at_index

    mov  r1, r4
    movi r2, #10
    movi r3, #0
    call linked_list_insert_at_index

    mov  r1, r4
    movi r2, #20
    movi r3, #1
    call linked_list_insert_at_index

    // Prints: [Size: 3] 10 -> 20 -> 30 -> NULL
    mov  r1, r4
    call linked_list_print_list

    // 3. Remove index 1 (the 20)
    mov  r1, r4
    movi r2, #1
    call linked_list_remove_at_index

    // Prints: [Size: 2] 10 -> 30 -> NULL
    mov  r1, r4
    call linked_list_print_list


    mov  r1, r4
    movi r2 #40
    movi r3, #2
    call linked_list_insert_at_index

    mov  r1, r4
    call linked_list_print_list

    // 4. Destroy the list completely (frees all nodes and the descriptor)
    mov  r1, r4
    call linked_list_destroy

    halt

stack:
    .space 100