// =============================================================================
// MODULE: Terminal Console I/O (lib/io.lx)
//
// Description:
//   Provides terminal console I/O routines (`prints`, `readln`, `readln_dynamic`)
//   interacting with keyboard and console MMIO registers.
// =============================================================================

// =============================================================================
// Subroutine: prints(r1: String) -> Unit
//
// Description:
//   Prints a null-terminated string to the terminal console (0xFF00).
//
// Inputs:
//   r1: String = Pointer to null-terminated string
// =============================================================================
prints:
	push r4
	.loop:
		lw r4 [r1 + #0]
		beq r0 r4 .done

		movi r2 0xFF00
		sw r4 [r2 + #0]

		addi r1 r1 #1

		beq r0 r0 .loop

	.done:
		pop r4
		ret


// =============================================================================
// Subroutine: readln(r1: CharArray) -> r1: CharArray
//
// Description:
//   Reads a line of text from the console into the provided buffer until Enter.
//
// Inputs:
//   r1: CharArray = Pointer to empty destination buffer
//
// Outputs:
//   r1: CharArray = Original pointer to start of buffer
// =============================================================================
readln:
	push r4
	push r5
	push r1

	movi r2 0xFF01
	movi r3 0xFF02
	movi r4 #10 // Newline check

	.loop:
		lw r5 [r3 + #0]
		beq r5 r0 .loop

		lw r5 [r2 + #0]

		beq r5 r4 .done

		sw r5 [r1 + #0]
		addi r1 r1 #1
		beq r0 r0 .loop

	.done:
		sw r0 [r1 + #0]

		pop r1
		pop r5
		pop r4
		ret


// =============================================================================
// Subroutine: readln_dynamic() -> r1: CharArray
//
// Description:
//   Reads arbitrary user input from stdin and returns a dynamically allocated string.
//
// Outputs:
//   r1: CharArray = Pointer to heap-allocated string
//
// Memory & Ownership:
//   - Caller must call free on r1.
// =============================================================================
readln_dynamic:
	push r7
	push r4
	push r5

	movi r5 0
	movi r1 8
	call alloc
	mov r4 r1

	push r4

	.read_loop:
		movi r2 0xFF02
		lw r3 [r2 + #0]
		beq r3 r0 .read_loop

		movi r2 0xFF01
		lw r3 [r2 + #0]

		movi r2 #10
		beq r3 r2 .readln_dynamic_done

		add r2 r4 r5
		sw r3 [r2 + #0]
		addi r5 r5 #1

		beq r0 r0 .read_loop

	.readln_dynamic_done:
		add r2 r4 r5
		sw r0 [r2 + #0]

		pop r2
		mov r1 r4
		pop r5
		pop r4
		pop r7
		ret
