main:
    movi r1, 1
    movi r2, 0xFF03
    sw   r1, [r2 + 0]       // DD_CTRL = 1 (Open)

    // Set coordinates
    movi r1, 10
    movi r2, 0xFF07
    sw   r1, [r2 + 0]       // DD_X = 10

    movi r1, 20
    movi r2, 0xFF08
    sw   r1, [r2 + 0]       // DD_Y = 20

    // Plot color (Triggers draw!)
    movi r1, 0x07E0          // Green
    movi r2, 0xFF09
    sw   r1, [r2 + 0]       // DD_COLOR = Green (Draws at 10, 20!)

    // Repaint window
    movi r1, 4
    movi r2, 0xFF03
    sw   r1, [r2 + 0]       // DD_CTRL = 4 (Refresh)