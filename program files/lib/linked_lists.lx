// =============================================================================
// MODULE: Linked List Data Structure (lib/linked_lists.lx)
//
// Description:
//   Provides dynamic singly linked list creation, node insertion, removal,
//   printing, and destruction.
//
// STRUCT: LinkedList (2 words)
// Layout:
//   [ptr + #0] : head (Node* or 0 for NULL)
//   [ptr + #1] : size (UShort count of active nodes)
//
// Node Layout (2 words):
//   [node + #0] : data (Short payload)
//   [node + #1] : next (Node* or 0 for NULL terminator)
// =============================================================================

// =============================================================================
// Subroutine: linked_list_create() -> r1: LinkedList
//
// Description:
//   Allocates and initializes a new empty linked list descriptor.
// =============================================================================
linked_list_create:
	push r7

	movi r1 #2
	call alloc

	sw r0 [r1 + #0]
	sw r0 [r1 + #1]

	pop r7
	ret


// =============================================================================
// Subroutine: linked_list_create_node(r1: Short) -> r1: Node
//
// Description:
//   Allocates and initializes a new list node with data payload.
// =============================================================================
linked_list_create_node:
	push r7
	push r4

	mov r4 r1

	movi r1 #2
	call alloc

	sw r4 [r1 + #0]
	sw r0 [r1 + #1]

	pop r4
	pop r7
	ret


// =============================================================================
// Subroutine: linked_list_insert_at_front(r1: LinkedList, r2: Short) -> Unit
//
// Description:
//   Inserts a new node with data at the front of the linked list.
// =============================================================================
linked_list_insert_at_front:
	push r7
	push r4
	push r5

	mov r4 r1
	mov r5 r2

	mov r1 r5
	call linked_list_create_node

	lw r2 [r4 + #0]
	sw r2 [r1 + #1]

	sw r1 [r4 + #0]

	lw r2 [r4 + #1]
	addi r2 r2 #1
	sw r2 [r4 + #1]

	pop r5
	pop r4
	pop r7
	ret


// =============================================================================
// Subroutine: linked_list_insert_at_index(r1: LinkedList, r2: Short, r3: Short) -> Unit
//
// Description:
//   Inserts a new node with data at the specified index.
// =============================================================================
linked_list_insert_at_index:
	beq r3 r0 linked_list_insert_at_front

	push r7
	push r4
	push r5

	mov r4 r1
	mov r5 r2

	lw r2 [r4 + #0]
	beq r2 r0 .insert_fallback

	subi r3 r3 #1

	.insert_walk:
		lw r1 [r2 + #1]
		beq r1 r0 .insert_splice
		beq r3 r0 .insert_splice
		mov r2 r1
		subi r3 r3 #1
		beq r0 r0 .insert_walk

	.insert_splice:
		push r2
		mov r1 r5
		call linked_list_create_node
		pop r2

		lw r5 [r2 + #1]
		sw r5 [r1 + #1]

		sw r1 [r2 + #1]

		lw r2 [r4 + #1]
		addi r2 r2 #1
		sw r2 [r4 + #1]
		beq r0 r0 .insert_done

	.insert_fallback:
		mov r1 r4
		mov r2 r5
		call linked_list_insert_at_front

	.insert_done:
		pop r5
		pop r4
		pop r7
		ret


// =============================================================================
// Subroutine: linked_list_remove_at_index(r1: LinkedList, r2: Short) -> Unit
//
// Description:
//   Removes the node at the specified index from the linked list.
// =============================================================================
linked_list_remove_at_index:
	lw r3 [r1 + #0]
	beq r3 r0 .remove_exit

	push r7
	push r4
	push r5

	mov r4 r1
	mov r3 r2

	beq r3 r0 .remove_head

	lw r2 [r4 + #0]
	subi r3 r3 #1

	.remove_walk:
		beq r2 r0 .remove_done
		beq r3 r0 .remove_found
		lw r2 [r2 + #1]
		subi r3 r3 #1
		beq r0 r0 .remove_walk

	.remove_found:
		lw r5 [r2 + #1]
		beq r5 r0 .remove_done

		lw r1 [r5 + #1]
		sw r1 [r2 + #1]

		mov r1 r5
		call free

		lw r2 [r4 + #1]
		subi r2 r2 #1
		sw r2 [r4 + #1]
		beq r0 r0 .remove_done

	.remove_head:
		lw r5 [r4 + #0]
		lw r2 [r5 + #1]
		sw r2 [r4 + #0]

		mov r1 r5
		call free

		lw r2 [r4 + #1]
		subi r2 r2 #1
		sw r2 [r4 + #1]

	.remove_done:
		pop r5
		pop r4
		pop r7

	.remove_exit:
		ret


// =============================================================================
// Subroutine: linked_list_print_list(r1: LinkedList) -> Unit
//
// Description:
//   Prints the linked list contents and size to the console.
// =============================================================================
linked_list_print_list:
	push r7
	push r4
	push r5

	mov r4 r1

	mov r5 r6
	addi r6 r6 #10

	movi r1 .size_str
	call prints

	lw r1 [r4 + #1]
	mov r2 r5
	call itoa
	call prints

	movi r1 .bracket_str
	call prints

	lw r4 [r4 + #0]

	.print_loop:
		beq r4 r0 .print_null

		lw r1 [r4 + #0]
		mov r2 r5
		call itoa
		call prints

		movi r1 .arrow_str
		call prints

		lw r4 [r4 + #1]
		beq r0 r0 .print_loop

	.print_null:
		movi r1 .null_str
		call prints

		subi r6 r6 #10
		pop r5
		pop r4
		pop r7
		ret

	.size_str:
		.fill "[Size: "
	.bracket_str:
		.fill "] "
	.arrow_str:
		.fill " -> "
	.null_str:
		.fill "NULL\n"


// =============================================================================
// Subroutine: linked_list_destroy(r1: LinkedList) -> Unit
//
// Description:
//   Frees all nodes and the list descriptor itself.
// =============================================================================
linked_list_destroy:
	push r7
	push r4
	push r5

	mov r4 r1
	lw r5 [r4 + #0]

	.free_loop:
		beq r5 r0 .free_list_obj

		lw r1 [r5 + #1]
		push r1

		mov r1 r5
		call free

		pop r5
		beq r0 r0 .free_loop

	.free_list_obj:
		mov r1 r4
		call free

		pop r5
		pop r4
		pop r7
		ret
