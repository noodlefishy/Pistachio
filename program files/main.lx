main: // DYNAMIC ARRAY ^^
    movi r6, stack
    call heap_init




    halt



// Inputs:	r1 = head reference variable
// 			r2 = data
insert_node:
	push r4
	push r5

	mov r4 r1	// r4 = head reference
	mov r5 r2	// r5 = data

	mov r1 r5
	push r7
	call create_node	// r1 = new node
	pop r7

	// newNode->next = *head reference
	lw r2 [r4 + #0]		// r2 = *headReference
	sw r2 [r1 + #1] 	// newNode->next = r2

	sw r1 [r4 + #0]

	pop r5
	pop r4
	ret


// Inputs: r1 = data
// Outputs: r1 = pointer to new Node on heap
create_node:
	push r4
	mov r4 r1 // save r4

	movi r1 #2 // [data, next]

	push r7
	call [alloc]
	pop r7

	sw r4 [r1 + #0] // new node -> data = data
	sw r0 [r1 + #1] // new node -> next = NULL(0)

	pop r4

	ret
stack:
    .space #100
formats:
    .fill "%d\n"
// Node
// 0: data
// 1: [next]

// data proposal
data:
    .fill {10 20 30 40 50}