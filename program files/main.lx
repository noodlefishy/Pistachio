main:
	movi r6 [stack]
	call gfx_init


    movi r1, #5
    movi r2, #10
    movi r3, #50
    movi r4, #25
    movi r5, 0x07FF
    call gfx_draw_line

	call gfx_present


    movi r1, #2
    movi r2, #40
    movi r3, #60
    movi r4, #48
    movi r5, 0xFFE0
    call gfx_draw_line

	call gfx_present

	call gfx_wait_until_close
	halt

stack:
    .space 100