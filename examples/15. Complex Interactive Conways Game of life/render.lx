// ===
// Module: Renderer & DMA Controls
// ===


// =============================================================================
// Subroutine: clear_grids() -> Unit
// =============================================================================
clear_grids:
	movi r2 0xFF30
	sw r0 [r2 + #0] // Fill value = 0
	movi r1 #4096
	sw r1 [r2 + #2]

	movi r1 grid_a
	sw r1 [r2 + #1]
	movi r1 #2
	sw r1 [r2 + #3] // Fill grid_a

	movi r1 grid_b
	sw r1 [r2 + #1]
	movi r1 #2
	sw r1 [r2 + #3] // Fill grid_b

	movi r1 age_grid
	sw r1 [r2 + #1]
	movi r1 #2
	sw r1 [r2 + #3] // Fill age_grid
	ret

// =============================================================================
// Subroutine: seed_grid() -> Unit
// =============================================================================
seed_grid:
	push r7
	push r4
	push r5
	push r1

	call clear_grids

	movi r4 grid_a
	addi r4 r4 #32
	addi r4 r4 #33
	movi r5 #1

	.seed_y_loop:
		movi r1 #63
		beq r5 r1 .seed_done

		movi r1 #62
		mov r2 r4
		movi r3 0x2000
		call random_weighted_array

		addi r4 r4 #32
		addi r4 r4 #32
		addi r5 r5 #1
		beq r0 r0 .seed_y_loop

	.seed_done:
		pop r1
		pop r5
		pop r4
		pop r7
		ret

// =============================================================================
// Subroutine: render_grid(r1: ShortArray) -> Unit
// =============================================================================
render_grid:
	push r7
	push r4
	push r5

	movi r2 is_age_mode
	lw r2 [r2 + #0]
	bne r2 r0 .setup_age_mode

	// ---- NORMAL MODE ----
	.setup_normal_mode:
		mov r4 r1
		addi r4 r4 #32
		addi r4 r4 #33
		movi r5 #1
		movi r7 0xFF07
		movi r1 .render_y_loop_normal
		jalr r0 r1 #0

	.render_y_loop_normal:
		movi r1 #63
		bne r5 r1 .continue_y_normal
		movi r1 .render_done
		jalr r0 r1 #0

	.continue_y_normal:
		movi r1 #1
		sw r1 [r7 + #0]
		sw r5 [r7 + #1]
		movi r3 #62
	.render_x_loop_normal:
		beq r3 r0 .render_row_done_normal
		lw r1 [r4 + #0]
		addi r4 r4 #1
		beq r1 r0 .draw_black_normal
	.draw_green_normal:
		movi r2 0x07E0
		sw r2 [r7 + #2]
		beq r0 r0 .next_cell_normal
	.draw_black_normal:
		sw r0 [r7 + #2]
	.next_cell_normal:
		subi r3 r3 #1
		beq r0 r0 .render_x_loop_normal
	.render_row_done_normal:
		addi r4 r4 #2
		addi r5 r5 #1
		movi r1 .render_y_loop_normal
		jalr r0 r1 #0

	// ---- AGE MODE ----
	.setup_age_mode:
		movi r4 age_grid
		addi r4 r4 #32
		addi r4 r4 #33

		movi r5 #1
		movi r7 0xFF07
		movi r1 .render_y_loop_age
		jalr r0 r1 #0

	.render_y_loop_age:
		movi r1 #63
		bne r5 r1 .continue_y_age
		movi r1 .render_done
		jalr r0 r1 #0

	.continue_y_age:
		movi r1 #1
		sw r1 [r7 + #0]
		sw r5 [r7 + #1]
		movi r3 #62

	.render_x_loop_age:
		beq r3 r0 .render_row_done_age

		lw r1 [r4 + #0]
		addi r4 r4 #1

		addi r1 r1 #7
		movi r2 age_palette
		add r2 r2 r1
		lw r2 [r2 + #0]
		sw r2 [r7 + #2]

		subi r3 r3 #1
		beq r0 r0 .render_x_loop_age

	.render_row_done_age:
		addi r4 r4 #2
		addi r5 r5 #1
		movi r1 .render_y_loop_age
		jalr r0 r1 #0

	.render_done:
		pop r5
		pop r4
		pop r7
		ret

// ===
// DATA SECTION: Palettes
// ===
age_palette:
	.fill { 0x1082 0x2104 0x3186 0x4208 0x630C 0x8410 0xA514 }
	.fill { 0x0000 }
	.fill { 0xFFFF 0xFFE0 0xFD20 0x07E0 0x07FF 0x001F 0x801F 0xF81F }