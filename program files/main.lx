main:
	movi r6 [stack]
	call gfx_init

	movi r1 #8
	movi r2 #8
	movi r3 #8
	movi r4 0x07E0
	call gfx_draw_v_line
	call gfx_present


	movi r1 #8
	movi r2 #8
	movi r3 #24
	movi r4 0x07E0
	call gfx_draw_h_line
	call gfx_present


	movi r1 #32
	movi r2 #8
	movi r3 #8
	movi r4 #16
	movi r5 0x07E0
	call gfx_draw_line
	call gfx_present


	call gfx_wait_until_close
	halt

stack:
    .space 100