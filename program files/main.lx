main: // DYNAMIC ARRAY ^^
    movi r6, stack
    call heap_init




    halt


insert_node:
	call create_node



create_node:
	push r4
	mov r4 r1 // save r4

	movi r1 #2 // [data, next]

	push r7
	call [alloc]
	pop r7

	sw r4 [r1 + #0] // new node -> data = data
	sw r0 [r1 + #1] // new node -> next = NULL(0)

	pop r4

	ret
stack:
    .space #100
formats:
    .fill "%d\n"
// Node
// 0: data
// 1: [next]

// data proposal
data:
    .fill {10 20 30 40 50}