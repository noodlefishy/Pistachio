// =============================================================================
// MODULE: Formatting & Conversions (lib/fmt.lx)
//
// Description:
//   Provides number/string conversion routines (`str_toi`, `itoa`, `itox`, `str_tox`,
//   `str_rev`) and formatted printing (`printf`).
// =============================================================================

// =============================================================================
// Subroutine: str_toi(r1: String) -> r1: Short
//
// Description:
//   Converts a null-terminated string to a #16-bit signed integer.
//
// Inputs:
//   r1: String = Pointer to string
//
// Outputs:
//   r1: Short = Converted #16-bit signed integer
// =============================================================================
str_toi:
	push r4
	push r5
	push r7

	add r4 r1 r0
	movi r5 #0

	.toi_loop:
		lw r3 [r4 + #0]
		beq r3 r0 .toi_done

		addi r3 r3 #-48

		add r1 r5 r0
		movi r2 #10
		call multiply

		add r5 r1 r3

		addi r4 r4 #1
		beq r0 r0 .toi_loop

	.toi_done:
		add r1 r5 r0
		pop r7
		pop r5
		pop r4
		ret


// =============================================================================
// Subroutine: itoa(r1: Short, r2: CharArray) -> r1: CharArray
//
// Description:
//   Converts a #16-bit signed integer to a decimal string.
//
// Inputs:
//   r1: Short = Integer to convert
//   r2: CharArray = Destination buffer pointer
//
// Outputs:
//   r1: CharArray = Destination buffer pointer
// =============================================================================
itoa:
	push r4
	push r5
	push r7
	push r2

	add r4 r2 r0

	movi r5 $SBIT
	nand r5 r1 r5
	nand r5 r5 r5
	beq r5 r0 .extract_digits

	movi r5 #45
	sw r5 [r4 + #0]
	addi r4 r4 #1

	nand r1 r1 r1
	addi r1 r1 #1

	.extract_digits:
		push r4

	.extract_loop:
		movi r2 #10
		call divide

		addi r3 r3 #48
		sw r3 [r4 + #0]
		addi r4 r4 #1

		beq r1 r0 .extraction_done
		beq r0 r0 .extract_loop

	.extraction_done:
		sw r0 [r4 + #0]

		add r2 r4 r0
		addi r2 r2 #-1

		pop r1
		call str_rev

		pop r1
		pop r7
		pop r5
		pop r4
		ret


// =============================================================================
// Subroutine: str_rev(r1: CharArray, r2: CharArray) -> Unit
//
// Description:
//   Reverses a string buffer in-place between start and end pointers.
// =============================================================================
str_rev:
	push r4
	push r5
	push r7

	.rev_loop:
		push r1
		push r2
		call lessThan
		add r3 r1 r0
		pop r2
		pop r1

		beq r3 r0 .rev_done

		lw r4 [r1 + #0]
		lw r5 [r2 + #0]
		sw r5 [r1 + #0]
		sw r4 [r2 + #0]

		addi r1 r1 #1
		addi r2 r2 #-1
		beq r0 r0 .rev_loop

	.rev_done:
		pop r7
		pop r5
		pop r4
		ret


// =============================================================================
// Subroutine: itox(r1: UShort, r2: CharArray) -> r1: CharArray
//
// Description:
//   Converts a #16-bit unsigned integer to a hexadecimal string.
//
// Inputs:
//   r1: UShort = Value to convert
//   r2: CharArray = Destination buffer pointer
//
// Outputs:
//   r1: CharArray = Destination buffer pointer
// =============================================================================
itox:
	push r4
	push r5
	push r7
	push r2

	add r4 r2 r0

	push r4

	.itox_loop:
		movi r2 #16
		call divide

		movi r5 #10

		push r1
		push r2
		push r3
		add r1 r3 r0
		add r2 r5 r0
		call lessThan
		add r5 r1 r0
		pop r3
		pop r2
		pop r1

		beq r5 r0 .itox_alpha

	.itox_digit:
		addi r3 r3 #48
		beq r0 r0 .itox_write

	.itox_alpha:
		addi r3 r3 #55

	.itox_write:
		sw r3 [r4 + #0]
		addi r4 r4 #1

		beq r1 r0 .itox_done
		beq r0 r0 .itox_loop

	.itox_done:
		sw r0 [r4 + #0]

		add r2 r4 r0
		addi r2 r2 #-1

		pop r1
		call str_rev

		pop r1
		pop r7
		pop r5
		pop r4
		ret


// =============================================================================
// Subroutine: str_tox(r1: String) -> r1: UShort
//
// Description:
//   Converts a null-terminated hexadecimal string to a #16-bit unsigned integer.
// =============================================================================
str_tox:
	push r4
	push r5
	push r7

	add r4 r1 r0
	movi r5 #0

	.tox_loop:
		lw r3 [r4 + #0]
		beq r3 r0 .tox_done

		movi r2 #65

		push r1
		push r2
		add r1 r3 r0
		call lessThan
		add r7 r1 r0
		pop r2
		pop r1

		beq r7 r0 .tox_alpha

	.tox_digit:
		addi r3 r3 #-48
		beq r0 r0 .tox_accumulate

	.tox_alpha:
		addi r3 r3 #-55

	.tox_accumulate:
		add r5 r5 r5
		add r5 r5 r5
		add r5 r5 r5
		add r5 r5 r5

		add r5 r5 r3

		addi r4 r4 #1
		beq r0 r0 .tox_loop

	.tox_done:
		add r1 r5 r0
		pop r7
		pop r5
		pop r4
		ret


// =============================================================================
// Subroutine: printf(r1: String, r2: ShortArray) -> Unit
//
// Description:
//   Formatted console printing supporting %d (decimal), %x (hex),
//   %s (string), %c (character), and %% (literal %).
//
// Inputs:
//   r1: String = Format string pointer
//   r2: ShortArray = Argument values array pointer
// =============================================================================
printf:
	push r7
	push r4
	push r5

	mov r4 r1
	mov r5 r2

	.printf_loop:
		lw r1 [r4 + #0]

		bne r1 r0 .not_null
		movi r7 .printf_done
		jalr r0 r7 #0

	.not_null:
		movi r2 #37
		beq r1 r2 .parse_specifier

		movi r2 0xFF00
		sw r1 [r2 + #0]

		movi r7 .next_char
		jalr r0 r7 #0

	.parse_specifier:
		addi r4 r4 #1
		lw r1 [r4 + #0]

		lw r2 [r5 + #0]

		movi r3 #100
		beq r1 r3 .print_dec

		movi r3 #120
		beq r1 r3 .print_hex

		movi r3 #115
		beq r1 r3 .print_str

		movi r3 #99
		beq r1 r3 .print_char

		movi r3 #37
		beq r1 r3 .print_percent

		movi r7 .next_char
		jalr r0 r7 #0

	.print_dec:
		mov r1 r2
		movi r2 printf_buf
		call itoa
		call prints

		addi r5 r5 #1
		movi r7 .next_char
		jalr r0 r7 #0

	.print_hex:
		mov r1 r2
		movi r2 printf_buf
		call itox
		call prints

		addi r5 r5 #1
		movi r7 .next_char
		jalr r0 r7 #0

	.print_str:
		mov r1 r2
		call prints

		addi r5 r5 #1
		movi r7 .next_char
		jalr r0 r7 #0

	.print_char:
		movi r3 0xFF00
		sw r2 [r3 + #0]

		addi r5 r5 #1
		movi r7 .next_char
		jalr r0 r7 #0

	.print_percent:
		movi r3 0xFF00
		movi r2 37
		sw r2 [r3 + #0]
		movi r7 .next_char
		jalr r0 r7 #0

	.next_char:
		addi r4 r4 #1
		movi r7 .printf_loop
		jalr r0 r7 #0

	.printf_done:
		pop r5
		pop r4
		pop r7
		ret

	printf_buf:
		.space 20
