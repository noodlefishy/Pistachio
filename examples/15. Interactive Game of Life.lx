// =============================================================================
// Example 15: Interactive Game of Life V2 (Modal Editor)
// Controls: WASD/Arrows (Move), E (Draw), Space/P (Pause), N (Step),
//           R (Reseed), C (Clear), Q (Toggle Age Mode)
// Run with: ./lx -i "examples/15. Interactive Game of Life.lx" "program files/lib"
// =============================================================================

main:
	movi r6 stack
	call heap_init
	call gfx_init

	clr r1
	call gfx_clear
	call gfx_present

	movi r1 rule_pointer
	lw r1 [r1 + #0]
	call parse_rule_string

	// r4 = active grid, r5 = back buffer
	movi r4 grid_a
	movi r5 grid_b

	call seed_grid

	// =========================================================================
	// Main Simulation Loop (State Machine)
	// =========================================================================
	.sim_loop:
		movi r2 0xFF06 // DD_STUS
		lw r1 [r2 + #0]
		bne r1 r0 .poll_input
		halt // Safely shutdown

	.poll_input:
		movi r2 0xFF0B
		lw r1 [r2 + #0]

		bne r1 r0 .handle_key

		// Arrow Key Edge Detection (0xFF0A)
		movi r2 is_paused
		lw r2 [r2 + #0]
		beq r2 r0 .jmp_eval_mode

		movi r7 .poll_arrows
		jalr r0 r7 #0

	.jmp_eval_mode:
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.handle_key:
		// Convert lowercase to uppercase
		movi r2 #97  // 'a'
		blt r1 r2 .route_key
		movi r2 #122 // 'z'
		bgt r1 r2 .route_key
		subi r1 r1 #32

	.route_key:
		// P (80), Space (32) -> Pause
		movi r2 #80
		beq r1 r2 .jmp_toggle
		movi r2 #32
		beq r1 r2 .jmp_toggle

		// R (82) -> Reseed, C (67) -> Clear, Q (81) -> Age Mode
		movi r2 #82
		beq r1 r2 .jmp_reseed
		movi r2 #67
		beq r1 r2 .jmp_clear
		movi r2 #81
		beq r1 r2 .jmp_age

		// Editor Keys (Only if paused)
		movi r2 is_paused
		lw r2 [r2 + #0]
		beq r2 r0 .end_routing

		// W (87), S (83), A (65), D (68)
		movi r2 #87
		beq r1 r2 .jmp_up
		movi r2 #83
		beq r1 r2 .jmp_down
		movi r2 #65
		beq r1 r2 .jmp_left
		movi r2 #68
		beq r1 r2 .jmp_right

		// E (69) -> Edit/Flip
		movi r2 #69
		beq r1 r2 .jmp_flip

		// N (78) -> Step
		movi r2 #78
		beq r1 r2 .jmp_step

	.end_routing:
		movi r7 .evaluate_mode
		jalr r0 r7 #0


	.jmp_toggle:
		movi r7 .toggle_pause
		jalr r0 r7 #0
	.jmp_reseed:
		movi r7 .do_reseed
		jalr r0 r7 #0
	.jmp_clear:
		movi r7 .do_clear
		jalr r0 r7 #0
	.jmp_age:
		movi r7 .toggle_age
		jalr r0 r7 #0
	.jmp_up:
		movi r7 .cursor_up
		jalr r0 r7 #0
	.jmp_down:
		movi r7 .cursor_down
		jalr r0 r7 #0
	.jmp_left:
		movi r7 .cursor_left
		jalr r0 r7 #0
	.jmp_right:
		movi r7 .cursor_right
		jalr r0 r7 #0
	.jmp_flip:
		movi r7 .flip_cell
		jalr r0 r7 #0
	.jmp_step:
		movi r7 .do_single_step
		jalr r0 r7 #0



	// -------------------------------------------------------------------------
	// Arrow Keys
	// -------------------------------------------------------------------------
	.poll_arrows:
		movi r2 0xFF0A
		lw r1 [r2 + #0]
		movi r2 prev_gpad
		lw r3 [r2 + #0]
		sw r1 [r2 + #0]

		not r3 r3
		and r1 r1 r3

		bne r1 r0 .check_arrow_bits
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.check_arrow_bits:
		movi r2 #1
		and r3 r1 r2
		bne r3 r0 .jmp_up
		movi r2 #2
		and r3 r1 r2
		bne r3 r0 .jmp_down
		movi r2 #4
		and r3 r1 r2
		bne r3 r0 .jmp_left
		movi r2 #8
		and r3 r1 r2
		bne r3 r0 .jmp_right
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	// -------------------------------------------------------------------------
	// Dispatch Trampolines
	// -------------------------------------------------------------------------


	// -------------------------------------------------------------------------
	// Action Handlers
	// -------------------------------------------------------------------------
	.do_reseed:
		movi r4 grid_a
		movi r5 grid_b
		call seed_grid
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.do_clear:
		movi r4 grid_a
		movi r5 grid_b
		call clear_grids
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.toggle_age:
		movi r2 is_age_mode
		lw r3 [r2 + #0]
		beq r3 r0 .set_age
		sw r0 [r2 + #0]
		movi r7 .evaluate_mode
		jalr r0 r7 #0
	.set_age:
		movi r3 #1
		sw r3 [r2 + #0]
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.toggle_pause:
		movi r2 is_paused
		lw r3 [r2 + #0]
		beq r3 r0 .set_paused
		sw r0 [r2 + #0] // Unpause
		movi r7 .evaluate_mode
		jalr r0 r7 #0
	.set_paused:
		movi r3 #1
		sw r3 [r2 + #0] // Pause
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	// -------------------------------------------------------------------------
	// Cursor Movement
	// -------------------------------------------------------------------------
	.cursor_up:
		movi r2 cursor_y
		lw r3 [r2 + #0]
		movi r1 #1
		beq r3 r1 .clamp_abort
		subi r3 r3 #1
		sw r3 [r2 + #0]
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.cursor_down:
		movi r2 cursor_y
		lw r3 [r2 + #0]
		movi r1 #62
		beq r3 r1 .clamp_abort
		addi r3 r3 #1
		sw r3 [r2 + #0]
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.cursor_left:
		movi r2 cursor_x
		lw r3 [r2 + #0]
		movi r1 #1
		beq r3 r1 .clamp_abort
		subi r3 r3 #1
		sw r3 [r2 + #0]
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.cursor_right:
		movi r2 cursor_x
		lw r3 [r2 + #0]
		movi r1 #62
		beq r3 r1 .clamp_abort
		addi r3 r3 #1
		sw r3 [r2 + #0]
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.clamp_abort:
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	// -------------------------------------------------------------------------
	// Flip Cell State
	// -------------------------------------------------------------------------
	.flip_cell:
		// Calculate offset into r3 = (y * 64) + x
		movi r2 cursor_y
		lw r3 [r2 + #0]
		add r3 r3 r3 // * 2
		add r3 r3 r3 // * 4
		add r3 r3 r3 // * 8
		add r3 r3 r3 // * 16
		add r3 r3 r3 // * 32
		add r3 r3 r3 // * 64

		movi r2 cursor_x
		lw r2 [r2 + #0]
		add r3 r3 r2 // r3 = offset
		add r1 r4 r3 // r1 = &active_grid[offset]

		// Toggle Grid
		lw r2 [r1 + #0]
		beq r2 r0 .make_alive
	.make_dead:
		sw r0 [r1 + #0]
		movi r1 age_grid
		add r1 r1 r3
		movi r2 #-1      // Instantly make it "Just Died"
		sw r2 [r1 + #0]
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.make_alive:
		movi r2 #1
		sw r2 [r1 + #0]
		movi r1 age_grid
		add r1 r1 r3
		movi r2 #1       // Instantly make it "Newborn"
		sw r2 [r1 + #0]
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	// -------------------------------------------------------------------------
	// Evaluation & Rendering
	// -------------------------------------------------------------------------
	.evaluate_mode:
		movi r2 is_paused
		lw r2 [r2 + #0]
		bne r2 r0 .render_only

	.advance_generation:
		mov r1 r4
		mov r2 r5
		call step_generation

//		mov r1 r5
//		movi r2 age_grid
//		call update_age_grid

		// Swap double buffers
		mov r1 r4
		mov r4 r5
		mov r5 r1

		movi r7 .render_only
		jalr r0 r7 #0

	.do_single_step:
		movi r7 .advance_generation
		jalr r0 r7 #0

	.render_only:
		mov r1 r4
		call render_grid

		movi r2 is_paused
		lw r2 [r2 + #0]
		beq r2 r0 .draw_border_running

	.draw_cursor:
		movi r3 blink_tick
		lw r2 [r3 + #0]
		addi r2 r2 #1
		sw r2 [r3 + #0]

		movi r1 #4
		and r2 r2 r1
		beq r2 r0 .draw_border_paused

		movi r1 cursor_x
		lw r1 [r1 + #0]
		movi r2 cursor_y
		lw r2 [r2 + #0]
		movi r3 0xF800
		call gfx_draw_pixel

	.draw_border_paused:
		push r4
		push r5
		movi r1 #0
		movi r2 #0
		movi r3 #64
		movi r4 #64
		movi r5 0xFD20 // Amber
		call gfx_draw_rect
		pop r5
		pop r4
		movi r7 .present
		jalr r0 r7 #0

	.draw_border_running:
		push r4
		push r5
		movi r1 #0
		movi r2 #0
		movi r3 #64
		movi r4 #64
		movi r5 0x0000 // Black
		call gfx_draw_rect
		pop r5
		pop r4

	.present:
		call gfx_present
		movi r7 .sim_loop
		jalr r0 r7 #0


// =============================================================================
// Subroutine: clear_grids()
// Uses Hardware DMA to instantly wipe grid_a, grid_b, and age_grid!
// =============================================================================
clear_grids:
	movi r2 0xFF30

	// Set Fill Value to 0 (Black / Dead)
	sw r0 [r2 + #0]

	// Set Length to 4096 words
	movi r1 #4096
	sw r1 [r2 + #2]

	// Trigger Command 2 (MEM_FILL) for grid_a
	movi r1 grid_a
	sw r1 [r2 + #1]  // Dest = grid_a
	movi r1 #2
	sw r1 [r2 + #3]  // Fire!

	// Trigger Command 2 for grid_b
	movi r1 grid_b
	sw r1 [r2 + #1]  // Dest = grid_b
	movi r1 #2
	sw r1 [r2 + #3]  // Fire!

	// Trigger Command 2 for age_grid
	movi r1 age_grid
	sw r1 [r2 + #1]  // Dest = age_grid
	movi r1 #2
	sw r1 [r2 + #3]  // Fire!

	ret

// =============================================================================
// Subroutine: seed_grid()
// =============================================================================
seed_grid:
	push r7
	push r4
	push r5
	push r1

	call clear_grids

	movi r4 grid_a
	addi r4 r4 #32
	addi r4 r4 #33
	movi r5 #1

	.seed_y_loop:
		movi r1 #63
		beq r5 r1 .seed_done

		movi r1 #62
		mov r2 r4
		movi r3 0x4000
		call random_weighted_array

		addi r4 r4 #32
		addi r4 r4 #32
		addi r5 r5 #1
		beq r0 r0 .seed_y_loop

	.seed_done:
		pop r1
		pop r5
		pop r4
		pop r7
		ret

// =============================================================================
// Subroutine: render_grid(r1: ShortArray)
// Updates cell ages AND draws to the screen in a single, hyper-optimised pass!
// =============================================================================
render_grid:
	push r7
	push r4
	push r5

	movi r2 is_age_mode
	lw r2 [r2 + #0]
	bne r2 r0 .setup_age_mode

	// ---- NORMAL MODE ----
	.setup_normal_mode:
		mov r4 r1
		addi r4 r4 #32
		addi r4 r4 #33
		movi r5 #1
		movi r7 0xFF07
		movi r1 .render_y_loop_normal
		jalr r0 r1 #0

	.render_y_loop_normal:
		movi r1 #63

		// TRAMPOLINE: If Y != 63, continue. Else jump to end!
		bne r5 r1 .continue_y_normal
		movi r1 .render_done
		jalr r0 r1 #0

	.continue_y_normal:
		movi r1 #1
		sw r1 [r7 + #0]
		sw r5 [r7 + #1]
		movi r3 #62
	.render_x_loop_normal:
		beq r3 r0 .render_row_done_normal
		lw r1 [r4 + #0]
		addi r4 r4 #1
		beq r1 r0 .draw_black_normal
	.draw_green_normal:
		movi r2 0x07E0
		sw r2 [r7 + #2]
		beq r0 r0 .next_cell_normal
	.draw_black_normal:
		sw r0 [r7 + #2]
	.next_cell_normal:
		subi r3 r3 #1
		beq r0 r0 .render_x_loop_normal
	.render_row_done_normal:
		addi r4 r4 #2
		addi r5 r5 #1
		movi r1 .render_y_loop_normal
		jalr r0 r1 #0


	// ---- AGE MODE (FUSED UPDATER + RENDERER) ----
	.setup_age_mode:
		// Push the active grid pointer to the stack so we can read states
		addi r1 r1 #32
		addi r1 r1 #33
		push r1 // [SP] = active_grid pointer

		movi r4 age_grid
		addi r4 r4 #32
		addi r4 r4 #33 // r4 = age_grid pointer

		movi r5 #1
		movi r7 0xFF07
		movi r1 .render_y_loop_age
		jalr r0 r1 #0

	.render_y_loop_age:
		movi r1 #63

		// TRAMPOLINE: If Y != 63, continue. Else jump to end!
		bne r5 r1 .continue_y_age
		movi r1 .render_done_age
		jalr r0 r1 #0

	.continue_y_age:
		movi r1 #1
		sw r1 [r7 + #0]
		sw r5 [r7 + #1]
		movi r3 #62

	.render_x_loop_age:
		// 1. Read cell state from active grid
		lw r2 [r6 + #-1] // load active_grid_ptr from stack
		lw r1 [r2 + #0]  // r1 = Cell State (0 or 1)
		addi r2 r2 #1
		sw r2 [r6 + #-1] // advance active_grid_ptr

		// 2. Read current age
		lw r2 [r4 + #0]  // r2 = Current Age

		// 3. Inline Age Update Math
		beq r1 r0 .inline_dead

	.inline_alive:
		movi r1 #0
		blt r2 r1 .reset_alive
		beq r2 r0 .reset_alive
		addi r2 r2 #1
		movi r1 #8
		bgt r2 r1 .cap_alive
		beq r0 r0 .save_age
	.reset_alive:
		movi r2 #1
		beq r0 r0 .save_age
	.cap_alive:
		movi r2 #8
		beq r0 r0 .save_age

	.inline_dead:
		movi r1 #0
		bgt r2 r1 .reset_dead
		beq r2 r0 .save_age
		subi r2 r2 #1
		movi r1 #-7
		blt r2 r1 .cap_dead
		beq r0 r0 .save_age
	.reset_dead:
		movi r2 #-1
		beq r0 r0 .save_age
	.cap_dead:
		movi r2 #0

	.save_age:
		sw r2 [r4 + #0] // Save updated age back to age_grid!
		addi r4 r4 #1   // advance age_grid ptr

		// 4. Look up palette color and draw
		add r1 r2 r0    // Copy age to r1
		addi r1 r1 #7   // Shift -7..8 to 0..15 array index
		movi r2 age_palette
		add r2 r2 r1
		lw r2 [r2 + #0] // r2 = Color
		sw r2 [r7 + #2] // Draw to MMIO

		subi r3 r3 #1

		// Trampoline back to loop top
		beq r3 r0 .render_row_done_age
		movi r1 .render_x_loop_age
		jalr r0 r1 #0

	.render_row_done_age:
		addi r4 r4 #2
		addi r5 r5 #1

		// Advance the active_grid_ptr over the borders too!
		lw r2 [r6 + #-1]
		addi r2 r2 #2
		sw r2 [r6 + #-1]

		movi r1 .render_y_loop_age
		jalr r0 r1 #0

	.render_done_age:
		pop r1 // Clear active_grid_ptr off the stack
		beq r0 r0 .render_done_actual

	.render_done:
	.render_done_actual:
		pop r5
		pop r4
		pop r7
		ret

// =============================================================================
// Subroutine: step_generation(r1 = current, r2 = next)
// =============================================================================
step_generation:
	push r7
	push r4
	push r5

	mov r5 r6
	addi r6 r6 #4
	sw r1 [r5 + #0]
	sw r2 [r5 + #1]
	movi r1 #1
	sw r1 [r5 + #3]

	.row_loop:
		lw r1 [r5 + #3]
		movi r2 #63
		bne r1 r2 .continue_row

		movi r7 .step_done
		jalr r0 r7 #0

	.continue_row:
		mov r3 r1
		add r3 r3 r3
		add r3 r3 r3
		add r3 r3 r3
		add r3 r3 r3
		add r3 r3 r3
		add r3 r3 r3

		lw r1 [r5 + #0]
		add r4 r1 r3
		addi r4 r4 #1

		subi r7 r4 #64

		addi r1 r4 #32
		addi r1 r1 #32

		lw r2 [r5 + #1]
		add r2 r2 r3
		addi r2 r2 #1
		sw r2 [r5 + #2]

		push r1

		movi r3 #62

	.col_loop:
		lw r1 [r7 + #-1]
		lw r2 [r7 + #0]
		add r1 r1 r2
		lw r2 [r7 + #1]
		add r1 r1 r2

		lw r2 [r4 + #-1]
		add r1 r1 r2
		lw r2 [r4 + #1]
		add r1 r1 r2

		lw r2 [r6 + #-1]
		lw r2 [r2 + #-1]
		add r1 r1 r2
		lw r2 [r6 + #-1]
		lw r2 [r2 + #0]
		add r1 r1 r2
		lw r2 [r6 + #-1]
		lw r2 [r2 + #1]
		add r1 r1 r2

		movi r2 pow2_table
		add r2 r2 r1
		lw r2 [r2 + #0]

		lw r1 [r4 + #0]
		beq r1 r0 .check_birth

	.check_survival:
		push r3
		movi r3 rule_survival
		lw r1 [r3 + #0]
		pop r3
		and r1 r1 r2
		bne r1 r0 .cell_alive
		beq r0 r0 .cell_dead

	.check_birth:
		push r3
		movi r3 rule_birth
		lw r1 [r3 + #0]
		pop r3
		and r1 r1 r2
		bne r1 r0 .cell_alive
		beq r0 r0 .cell_dead

	.cell_alive:
		lw r2 [r5 + #2]
		movi r1 #1
		sw r1 [r2 + #0]
		addi r2 r2 #1
		sw r2 [r5 + #2]
		beq r0 r0 .advance_cell

	.cell_dead:
		lw r2 [r5 + #2]
		sw r0 [r2 + #0]
		addi r2 r2 #1
		sw r2 [r5 + #2]

	.advance_cell:
		addi r7 r7 #1
		addi r4 r4 #1

		lw r2 [r6 + #-1]
		addi r2 r2 #1
		sw r2 [r6 + #-1]

		subi r3 r3 #1

		beq r3 r0 .row_finished
		movi r1 .col_loop
		jalr r0 r1 #0

	.row_finished:
		pop r1
		lw r1 [r5 + #3]
		addi r1 r1 #1
		sw r1 [r5 + #3]
		movi r7 .row_loop
		jalr r0 r7 #0

	.step_done:
		subi r6 r6 #4
		pop r5
		pop r4
		pop r7
		ret

// =============================================================================
// Subroutine: parse_rule_string
// =============================================================================
parse_rule_string:
	push r7
	push r4
	push r5

	mov r4 r1
	movi r5 rule_birth

	movi r2 rule_birth
	sw r0 [r2 + #0]
	movi r2 rule_survival
	sw r0 [r2 + #0]

	.parse_loop:
		lw r1 [r4 + #0]
		bne r1 r0 .continue_parse
		movi r7 .parse_done
		jalr r0 r7 #0

	.continue_parse:
		addi r4 r4 #1

		movi r2 #48
		blt r1 r2 .check_letters
		movi r2 #56
		bgt r1 r2 .check_letters

		subi r1 r1 #48
		movi r2 pow2_table
		add r2 r2 r1
		lw r2 [r2 + #0]
		lw r3 [r5 + #0]
		or r3 r3 r2
		sw r3 [r5 + #0]

		movi r7 .parse_loop
		jalr r0 r7 #0

	.check_letters:
		movi r2 #66
		beq r1 r2 .set_mode_birth
		movi r2 #98
		beq r1 r2 .set_mode_birth

		movi r2 #83
		beq r1 r2 .set_mode_survival
		movi r2 #115
		beq r1 r2 .set_mode_survival

		movi r7 .parse_loop
		jalr r0 r7 #0

	.set_mode_birth:
		movi r5 rule_birth
		movi r7 .parse_loop
		jalr r0 r7 #0

	.set_mode_survival:
		movi r5 rule_survival
		movi r7 .parse_loop
		jalr r0 r7 #0

	.parse_done:
		pop r5
		pop r4
		pop r7
		ret

// =============================================================================
// DATA SECTION
// =============================================================================
rule_pointer:
	.fill rule_morley


rule_replicator:
	.fill "B1357/S1357"
rule_seeds:
	.fill "B2/S"
rule_life_without_death:
	.fill "B3/S012345678"
rule_conway:
	.fill "B3/S23"
rule_34_life:
	.fill "B34/S34"
rule_diamoeba:
	.fill "B35678/S5678"
rule_2x2:
	.fill "B36/S125"
rule_highlife:
	.fill "B36/S23"
rule_day_night:
	.fill "B3678/S34678"
rule_morley:
	.fill "B368/S245"
rule_anneal:
	.fill "B4678/S35678"

age_palette:
	// Indexes 0 to 6 (Dying Trail: Faint Gray up to Bright Gray)
	.fill { 0x1082 0x2104 0x3186 0x4208 0x630C 0x8410 0xA514 }

	// Index 7 (Dead forever: Black)
	.fill { 0x0000 }

	// Indexes 8 to 15 (Alive: White, Yellow, Orange, Green, Cyan, Blue, Purple, Magenta)
	.fill { 0xFFFF 0xFFE0 0xFD20 0x07E0 0x07FF 0x001F 0x801F 0xF81F }

pow2_table:     .fill { 1 2 4 8 16 32 64 128 256 }

is_paused:      .fill 0 // Booleans
is_age_mode:    .fill 0 // Booleans
cursor_x:       .fill 31
cursor_y:       .fill 31
blink_tick:     .fill 0
prev_gpad:      .fill 0

rule_birth:     .space 1
rule_survival:  .space 1

grid_a:         .space 4096
grid_b:         .space 4096
age_grid:       .space 4096

stack:          .space 100