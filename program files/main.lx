main: // DYNAMIC ARRAY ^^
    movi r6, stack
    call heap_init




    halt



print_linked_list:
	push r4
	mov r4 r1

	.print_loop:
		beq r4 r0 .print_null

		lw r1 [r4 + #0]
		movi r2 [itoa_buffer]

		push r7
		call itoa
		pop r7
		push r7
		call prints
		pop r7

		movi r1 [arrow_string]

		push r7
		call prints
		pop r7

		// current = current -> next
		lw r4 [r4 + #1]
		beq r0 r0 .print_loop
	.print_null:
		movi r1 [null_string]
		push r7
		call prints
		pop r7
		pop r4
		return



// Inputs:	r1 = head reference variable
// 			r2 = data
insert_node:
	push r4
	push r5

	mov r4 r1	// r4 = head reference
	mov r5 r2	// r5 = data

	mov r1 r5
	push r7
	call create_node	// r1 = new node
	pop r7

	// newNode->next = *head reference
	lw r2 [r4 + #0]		// r2 = *headReference
	sw r2 [r1 + #1] 	// newNode->next = r2

	sw r1 [r4 + #0]

	pop r5
	pop r4
	ret


// Inputs: r1 = data
// Outputs: r1 = pointer to new Node on heap
create_node:
	push r4
	mov r4 r1 // save r4

	movi r1 #2 // [data, next]

	push r7
	call [alloc]
	pop r7

	sw r4 [r1 + #0] // new node -> data = data
	sw r0 [r1 + #1] // new node -> next = NULL(0)

	pop r4

	ret
stack:
    .space #100
formats:
    .fill "%d\n"
// Node
// 0: data
// 1: [next]
head:      .fill 0
arrow_string: .fill " -> "
null_string:  .fill "NULL\n"
itoa_buffer:  .space 10


// data proposal
data:
    .fill {10 20 30 40 50}