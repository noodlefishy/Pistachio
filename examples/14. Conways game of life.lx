main:
	movi r6 stack
	call heap_init
	call gfx_init

	movi r1 #4096 // 64 * 64
	movi r2 panel
	movi r3 0x4000
	call random_weighted_array

	clr r1
	call gfx_clear

	movi r4 panel
	movi r5 #0

	.y_loop:
		movi r1 #64
		beq r5 r1 .done

		movi r3 #0

	.x_loop:
		movi r1 #64
		beq r3 r1 .row_done

		lw r1 [r4 + #0]
		addi r4 r4 #1
		beq r1 r0 .skip_pixel

		push r3 // Preserve X
		push r5 // Preserve Y
		mov r1 r3 // r1 = X
		mov r2 r5 // r2 = Y
		movi r3 0xF800 // r3 = Red
		call gfx_draw_pixel
		pop r5 // Restore Y
		pop r3 // Restore X

	.skip_pixel:
		addi r3 r3 #1 // X++
		beq r0 r0 .x_loop

	.row_done:
		call gfx_present
		addi r5 r5 #1 // Y++
		beq r0 r0 .y_loop

	.done:
		call gfx_wait_until_close
		halt


panel:
	.space 4096

stack:
	.space 64