// =============================================================================
// MODULE: Mathematical Algorithms (lib/maths.lx)
//
// Description:
//   Provides 16-bit arithmetic routines (multiply, divide, modulus, subtract,
//   lessThan), pseudorandom number generation, and randomized array helpers
//   (noise, boolean, and weighted arrays).
// =============================================================================

// =============================================================================
// Subroutine: random_noise_array(r1: Short, r2: ShortArray) -> Unit
//
// Description:
//   Fills a memory array with pseudorandom 16-bit noise words using LCG.
//
// Inputs:
//   r1: Short = Number of elements to generate (size)
//   r2: ShortArray = Pointer to destination memory buffer
//
// Registers:
//   Preserved: r4 r5 r7
//   Clobbered: r1 r2 r3
// =============================================================================
random_noise_array:
	push r7
	push r4
	push r5

	mov r5 r1 // r5 = remaining count
	mov r4 r2 // r4 = array destination pointer

	beq r5 r0 .done

	movi r2 .seed
	lw r1 [r2 + #0] // r1 = seed

	.noise_loop:
		call random // r1 = next random number (and new seed)

		sw r1 [r4 + #0] // Store random word into array[ptr]
		addi r4 r4 #1 // ptr++
		subi r5 r5 #1 // count--
		bne r5 r0 .noise_loop

	movi r2 .seed
	sw r1 [r2 + #0]

	.done:
		pop r5
		pop r4
		pop r7
		ret

	.seed:
		.fill 1337


// =============================================================================
// Subroutine: random_bool_array(r1: Short, r2: ShortArray) -> Unit
//
// Description:
//   Fills an array with boolean values (0 or 1) with 50% probability.
//
// Inputs:
//   r1: Short = Size of array
//   r2: ShortArray = Pointer to destination memory buffer
// =============================================================================
random_bool_array:
	push r7
	push r4
	push r5

	mov r4 r1 // r4 = size
	mov r5 r2 // r5 = array_ptr

	call random_noise_array

	mov r1 r5 // r1 = walker pointer
	mov r2 r4 // r2 = remaining counter
	movi r3 $SBIT // r3 = Sign Bit mask (0x8000)

	.convert_loop:
		beq r2 r0 .done
		lw r4 [r1 + #0]
		and r4 r4 r3 // Check MSB (Sign Bit)
		beq r4 r0 .set_zero

	.set_one:
		movi r4 1
		sw r4 [r1 + #0] // 1 (true)
		beq r0 r0 .next

	.set_zero:
		sw r0 [r1 + #0] // 0 (false)

	.next:
		addi r1 r1 1
		subi r2 r2 1
		beq r0 r0 .convert_loop

	.done:
		pop r5
		pop r4
		pop r7
		ret


// =============================================================================
// Subroutine: random_weighted_array(r1: Short, r2: ShortArray, r3: UShort) -> Unit
//
// Description:
//   Fills an array with weighted boolean values (0 or 1) based on a threshold.
//   15-Bit Overflow-Free Thresholds:
//     0x0000 (0)     = 0%   Alive
//     0x2000 (8192)  = 25%  Alive (Ideal for Game of Life)
//     0x7FFF (32767) = 100% Alive
//
// Inputs:
//   r1: Short = Size
//   r2: ShortArray = Array pointer
//   r3: UShort = Threshold value
// =============================================================================
random_weighted_array:
	push r7
	push r4
	push r5
	push r3

	mov r4 r1 // r4 = size
	mov r5 r2 // r5 = array_ptr

	call random_noise_array

	mov r1 r5 // r1 = walker pointer
	mov r2 r4 // r2 = remaining counter
	pop r3 // restore threshold into r3

	movi r7 $MXIT // 0x7FFF (masks out sign bit to guarantee NO overflow)

	.convert_loop:
		beq r2 r0 .done
		lw r4 [r1 + #0]

		and r4 r4 r7 // Force range [0 .. 32767]

		bgt r4 r3 .set_zero

	.set_one:
		movi r4 1
		sw r4 [r1 + #0] // 1 (Alive)
		beq r0 r0 .next

	.set_zero:
		sw r0 [r1 + #0] // 0 (Dead)

	.next:
		addi r1 r1 #1
		subi r2 r2 #1
		beq r0 r0 .convert_loop

	.done:
		pop r5
		pop r4
		pop r7
		ret


// =============================================================================
// Subroutine: random(r1: Short) -> r1: Short
//
// Description:
//   Linear Congruential Generator for pseudorandom numbers.
//   X_{n+1} = (a * X_n + c) mod m
//
// Inputs:
//   r1: Short = Current seed
//
// Outputs:
//   r1: Short = Next seed / random number
// =============================================================================
random:
	push r7

	movi r2 #25173
	call multiply

	movi r2 #13849
	add r1 r1 r2

	pop r7
	ret


// =============================================================================
// Subroutine: modulus(r1: Short, r2: Short) -> r1: Short
//
// Description:
//   Computes r1 % r2 using division.
//
// Inputs:
//   r1: Short = Dividend
//   r2: Short = Divisor
//
// Outputs:
//   r1: Short = Remainder
// =============================================================================
modulus:
	push r7
	call divide
	pop r7

	add r1 r3 r0
	ret


// =============================================================================
// Subroutine: divide(r1: Short, r2: Short) -> (r1: Short, r3: Short)
//
// Description:
//   16-cycle binary long division.
//
// Inputs:
//   r1: Short = Dividend
//   r2: Short = Divisor
//
// Outputs:
//   r1: Short = Quotient
//   r3: Short = Remainder
// =============================================================================
divide:
	push r4
	push r5
	push r7

	movi r3 #0
	movi r4 #16

	.div_loop:
		add r3 r3 r3

		movi r5 $SBIT
		nand r5 r1 r5
		nand r5 r5 r5

		beq r5 r0 .skip_carry
		addi r3 r3 #1

	.skip_carry:
		add r1 r1 r1

		nand r5 r2 r2
		addi r5 r5 #1
		add r5 r3 r5

		movi r7 $SBIT
		nand r7 r5 r7
		nand r7 r7 r7

		movi r5 $SBIT
		beq r7 r5 .skip_sub

		nand r5 r2 r2
		addi r5 r5 #1
		add r3 r3 r5

		addi r1 r1 #1

	.skip_sub:
		addi r4 r4 #-1
		beq r4 r0 .div_done
		beq r0 r0 .div_loop

	.div_done:
		pop r7
		pop r5
		pop r4
		ret


// =============================================================================
// Subroutine: lessThan(r1: Short, r2: Short) -> r1: Boolean
//
// Description:
//   Compares r1 and r2. Returns -32768 (true) if r1 < r2, else 0 (false).
// =============================================================================
lessThan:
	nand r2 r2 r2
	addi r2 r2 #1
	add r1 r1 r2

	movi r3 $SBIT
	nand r1 r1 r3
	nand r1 r1 r1
	ret


// =============================================================================
// Subroutine: multiply(r1: Short, r2: Short) -> r1: Short
//
// Description:
//   Performs 16-bit integer multiplication using bit-shift addition.
// =============================================================================
multiply:
	push r4
	push r3
	push r5
	push r7

	movi r7 #0
	movi r3 #1
	movi r4 #16

	.mult_loop:
		nand r5 r1 r3
		nand r5 r5 r5

		beq r5 r0 .skip_add

		add r7 r7 r2

	.skip_add:
		add r2 r2 r2
		add r3 r3 r3

		addi r4 r4 #-1
		beq r4 r0 .mult_done
		beq r0 r0 .mult_loop

	.mult_done:
		add r1 r7 r0

		pop r7
		pop r5
		pop r3
		pop r4
		ret


// =============================================================================
// Subroutine: subtract(r1: Short, r2: Short) -> r1: Short
//
// Description:
//   Computes r1 - r2.
// =============================================================================
subtract:
	nand r2 r2 r2
	addi r2 r2 #1
	add r1 r1 r2
	ret
