heap_init:
	movi r1 [heap_start]
	movi r2 #100
	sw r2 [r1 + #0] 	// writing initial header:  Size 100 free

	add r1 r1 r2
	sw r0 [r1 + #0]
	ret


// Inputs: r1 = Requested payload size
// Output: r1 = Pointer to allocated memory
alloc:
	push r4
	push r5

	addi r1 r1 #1		// Needed block size is PL + 1

	// Even-ify block size
	// So Bit 0 is always free to be used as a flag
	movi r2 #1
	and r2 r1 r2
	beq r2 r0 .size_even
	addi r1 r1 #1

	.size_even: movi heap_start

	.alloc_loop:
		lw r5

		beq r5 r0 .out_of_memory

		// check if block is used (r5 & 1)
		movi r2 #1
		and r2 r5 r2
		bne r2 r0 .next_block


		// r3 = r5 & 0xFFFE(-2) | extract block size
		movi r2 #-2
		and r3 r5 r2

		blt r3 r1 .next_block		// if block_size (3) < needed_size (r1)

		// Therefor this is the 'found free block'
		// mark as used (needed_size(r1) | 1)
		movi r2, 1
       	or   r2, r1, r2
       	sw   r2, [r4 + 0]

		sub  r2, r3, r1

		movi r3 #2
		blt r2 r3 .done_alloc


		// Create a new FREE header for the leftover space at (r4 + needed_size)
		add r3 r4 r1
		sw r2 [r3 0]


	.next_block:
		// Advance to next block pointer
		// r4 = r4 + block_size (r3)
		add r4 r4 r3
		beq r0 r0 .alloc_loop

	.out_of_memory:
		clr r1
		pop r5
		pop r4
		ret

	.done_alloc:
		addi r1 r4 #1
		pop r5
		pop r4
		ret

.heap_start: .space 101
.heap_end