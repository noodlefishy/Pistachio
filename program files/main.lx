main: // DYNAMIC ARRAY ^^
    movi r6, stack
    call heap_init
    movi r1 #2
    call alloc
    movi r5 #10 // data
    sw r5 [r1 + #0]
    sw r0 [r1 + #1]


    halt

stack:
    .space #100
formats:
    .fill "%d\n"
// Node
// 0: data
// 1: [next]

// data proposal
data:
    .fill {10 20 30 40 50}