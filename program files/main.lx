main: // DYNAMIC ARRAY ^^
    movi r6, stack
    call heap_init




    halt


insert_node:
	call create_node



create_node:
	push r2

	add r2 r1 r0
	movi r1 #2
	call alloc

	lw r2 [r1 + #0] // data
	lw r0 [r1 + #1] // pointer

	pop r2 // non destructive for testing

	ret



stack:
    .space #100
formats:
    .fill "%d\n"
// Node
// 0: data
// 1: [next]

// data proposal
data:
    .fill {10 20 30 40 50}