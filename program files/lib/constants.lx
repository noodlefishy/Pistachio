// 3x5 Font Table (5 words per character, 1 row per word: 0 to 7)
internal_font_3x5:
	.fill { 0 0 0 0 0 } // ' '
	.fill { 2 2 2 0 2 } // '!'
	.fill { 0 0 0 0 0 } // '"'
	.fill { 0 0 0 0 0 } // '#'
	.fill { 0 0 0 0 0 } // '$'
	.fill { 0 0 0 0 0 } // '%'
	.fill { 0 0 0 0 0 } // '&'
	.fill { 0 0 0 0 0 } // '''
	.fill { 0 0 0 0 0 } // '('
	.fill { 0 0 0 0 0 } // ')'
	.fill { 0 0 0 0 0 } // '*'
	.fill { 0 2 7 2 0 } // '+'
	.fill { 0 0 0 0 0 } // ','
	.fill { 0 0 7 0 0 } // '-'
	.fill { 0 0 0 0 2 } // '.'
	.fill { 1 1 2 4 4 } // '/'
	.fill { 7 5 5 5 7 } // '0'
	.fill { 2 6 2 2 7 } // '1'
	.fill { 7 1 7 4 7 } // '2'
	.fill { 7 1 7 1 7 } // '3'
	.fill { 5 5 7 1 1 } // '4'
	.fill { 7 4 7 1 7 } // '5'
	.fill { 7 4 7 5 7 } // '6'
	.fill { 7 1 2 2 2 } // '7'
	.fill { 7 5 7 5 7 } // '8'
	.fill { 7 5 7 1 7 } // '9'
	.fill { 0 2 0 2 0 } // ':'
	.fill { 0 0 0 0 0 } // ';'
	.fill { 0 0 0 0 0 } // '<'
	.fill { 0 7 0 7 0 } // '='
	.fill { 0 0 0 0 0 } // '>'
	.fill { 7 1 2 0 2 } // '?'
	.fill { 0 0 0 0 0 } // '@'
	.fill { 2 5 7 5 5 } // 'A'
	.fill { 6 5 6 5 6 } // 'B'
	.fill { 7 4 4 4 7 } // 'C'
	.fill { 6 5 5 5 6 } // 'D'
	.fill { 7 4 7 4 7 } // 'E'
	.fill { 7 4 7 4 4 } // 'F'
	.fill { 7 4 5 5 7 } // 'G'
	.fill { 5 5 7 5 5 } // 'H'
	.fill { 7 2 2 2 7 } // 'I'
	.fill { 1 1 1 5 2 } // 'J'
	.fill { 5 5 6 5 5 } // 'K'
	.fill { 4 4 4 4 7 } // 'L'
	.fill { 5 7 5 5 5 } // 'M'
	.fill { 6 5 5 5 5 } // 'N'
	.fill { 7 5 5 5 7 } // 'O'
	.fill { 7 5 7 4 4 } // 'P'
	.fill { 7 5 5 6 3 } // 'Q'
	.fill { 6 5 6 5 5 } // 'R'
	.fill { 7 4 7 1 7 } // 'S'
	.fill { 7 2 2 2 2 } // 'T'
	.fill { 5 5 5 5 7 } // 'U'
	.fill { 5 5 5 5 2 } // 'V'
	.fill { 5 5 5 7 5 } // 'W'
	.fill { 5 5 2 5 5 } // 'X'
	.fill { 5 5 2 2 2 } // 'Y'
	.fill { 7 1 2 4 7 } // 'Z'
