main:
    movi r6, stack
    call heap_init

    // 1. Execute SIMD addition
    movi r1, a
    movi r2, b
    movi r3, r
    call padd

    // 2. Format and print using printf
    movi r1, fs
    movi r2 a
    call printf

    halt

fs:    .fill "Results of { %d %d %d %d } + { %d %d %d %d }:\n  %d\n  %d\n  %d\n  %d\n"
a:     .fill {10 20 30 40}
b:     .fill {5 5 5 5}
r:     .space 4

stack:
    .space 100 // hmmm