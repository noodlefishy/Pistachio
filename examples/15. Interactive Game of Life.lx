// =============================================================================
// Example 15: Interactive Game of Life V2 (Modal Editor)
// Run with: ./lx -i "examples/15. Interactive Game of Life.lx" "program files/lib"
// =============================================================================

main:
	movi r6 stack
	call heap_init
	call gfx_init

	clr r1
	call gfx_clear
	call gfx_present

	// 1. Parse rule string
	movi r1 rule_day_night // THANK YOU!!!!! RAWRR!!!!!
	call parse_rule_string

	// r4 = active grid, r5 = back buffer
	movi r4 grid_a
	movi r5 grid_b

	// Initialise 62x62 inner grid with 25% alive density
	call seed_grid

	// =========================================================================
	// Main Simulation Loop (State Machine)
	// =========================================================================
	.sim_loop:
		// 1. Check if user clicked window 'X'
		movi r2 0xFF06 // DD_STUS
		lw r1 [r2 + #0]
		bne r1 r0 .poll_input
		halt // Safely shutdown

.poll_input:
		// 1. Poll text input (0xFF0B)
		movi r2 0xFF0B
		lw r1 [r2 + #0]
		bne r1 r0 .handle_key // If an ASCII key was pressed (WASD, E, P, R, C), handle it!

		// 2. If no text key, check Arrow Keys via Gamepad (0xFF0A)
		movi r2 is_paused
		lw r2 [r2 + #0]
		beq r2 r0 .jmp_eval_mode // Only poll arrows if paused

		movi r7 .poll_arrows
		jalr r0 r7 #0

	.jmp_eval_mode:
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.handle_key:
		// Convert lowercase to uppercase
		movi r2 #97  // 'a'
		blt r1 r2 .route_key
		movi r2 #122 // 'z'
		bgt r1 r2 .route_key
		subi r1 r1 #32 // Convert to Upper

	.route_key:
		// 'P' (80) or Space (32) -> Toggle Pause
		movi r2 #80
		beq r1 r2 .jmp_toggle
		movi r2 #32
		beq r1 r2 .jmp_toggle

		// 'R' (82) -> Reseed
		movi r2 #82
		beq r1 r2 .jmp_reseed

		// 'C' (67) -> Clear Grid
		movi r2 #67
		beq r1 r2 .jmp_clear

		// --- Editor Keys (Only work if paused) ---
		movi r2 is_paused
		lw r2 [r2 + #0]
		beq r2 r0 .end_routing

		// 'W' (87) -> Up
		movi r2 #87
		beq r1 r2 .jmp_up
		// 'S' (83) -> Down
		movi r2 #83
		beq r1 r2 .jmp_down
		// 'A' (65) -> Left
		movi r2 #65
		beq r1 r2 .jmp_left
		// 'D' (68) -> Right
		movi r2 #68
		beq r1 r2 .jmp_right

		// 'E' (69) -> Flip Cell (Replaced Z and Enter!)
		movi r2 #69
		beq r1 r2 .jmp_flip

		// 'N' (78) -> Single Step Forward
		movi r2 #78
		beq r1 r2 .jmp_step

	.end_routing:
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	// -------------------------------------------------------------------------
	// Dispatch Trampolines (Bypasses 7-bit Branch Limit)
	// -------------------------------------------------------------------------
	.jmp_toggle:
		movi r7 .toggle_pause
		jalr r0 r7 #0
	.jmp_reseed:
		movi r7 .do_reseed
		jalr r0 r7 #0
	.jmp_clear:
		movi r7 .do_clear
		jalr r0 r7 #0
	.jmp_up:
		movi r7 .cursor_up
		jalr r0 r7 #0
	.jmp_down:
		movi r7 .cursor_down
		jalr r0 r7 #0
	.jmp_left:
		movi r7 .cursor_left
		jalr r0 r7 #0
	.jmp_right:
		movi r7 .cursor_right
		jalr r0 r7 #0
	.jmp_flip:
		movi r7 .flip_cell
		jalr r0 r7 #0
	.jmp_step:
		movi r7 .do_single_step
		jalr r0 r7 #0

	// -------------------------------------------------------------------------
    // Arrow Key Handler (Reads 0xFF0A with Edge-Detection)
    // -------------------------------------------------------------------------
    .poll_arrows:
    	movi r2 0xFF0A
    	lw r1 [r2 + #0] // Read live gamepad state

    	// Edge detection: r1 = current & ~prev_gpad
    	movi r2 prev_gpad
    	lw r3 [r2 + #0]
    	sw r1 [r2 + #0] // prev_gpad = current

    	not r3 r3
    	and r1 r1 r3 // r1 now only contains NEW button presses!

    	bne r1 r0 .check_arrow_bits
    	movi r7 .evaluate_mode
    	jalr r0 r7 #0

    .check_arrow_bits:
    	// Bit 0 (0x0001): Up Arrow
    	movi r2 #1
    	and r3 r1 r2
    	bne r3 r0 .jmp_up

    	// Bit 1 (0x0002): Down Arrow
    	movi r2 #2
    	and r3 r1 r2
    	bne r3 r0 .jmp_down

    	// Bit 2 (0x0004): Left Arrow
    	movi r2 #4
    	and r3 r1 r2
    	bne r3 r0 .jmp_left

    	// Bit 3 (0x0008): Right Arrow
    	movi r2 #8
    	and r3 r1 r2
    	bne r3 r0 .jmp_right

    	movi r7 .evaluate_mode
    	jalr r0 r7 #0

	// -------------------------------------------------------------------------
	// Action Handlers
	// -------------------------------------------------------------------------
	.do_reseed:
		movi r4 grid_a
		movi r5 grid_b
		call seed_grid
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.do_clear:
		call clear_grids
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.toggle_pause:
		movi r2 is_paused
		lw r3 [r2 + #0]
		beq r3 r0 .set_paused
		sw r0 [r2 + #0] // Unpause
		movi r7 .evaluate_mode
		jalr r0 r7 #0
	.set_paused:
		movi r3 #1
		sw r3 [r2 + #0] // Pause
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	// -------------------------------------------------------------------------
	// Cursor Movement (Clamped between 1 and 62)
	// -------------------------------------------------------------------------
	.cursor_up:
		movi r2 cursor_y
		lw r3 [r2 + #0]
		movi r1 #1
		beq r3 r1 .clamp_abort // Clamp min Y = 1
		subi r3 r3 #1
		sw r3 [r2 + #0]
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.cursor_down:
		movi r2 cursor_y
		lw r3 [r2 + #0]
		movi r1 #62
		beq r3 r1 .clamp_abort // Clamp max Y = 62
		addi r3 r3 #1
		sw r3 [r2 + #0]
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.cursor_left:
		movi r2 cursor_x
		lw r3 [r2 + #0]
		movi r1 #1
		beq r3 r1 .clamp_abort // Clamp min X = 1
		subi r3 r3 #1
		sw r3 [r2 + #0]
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.cursor_right:
		movi r2 cursor_x
		lw r3 [r2 + #0]
		movi r1 #62
		beq r3 r1 .clamp_abort // Clamp max X = 62
		addi r3 r3 #1
		sw r3 [r2 + #0]
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.clamp_abort:
		movi r7 .evaluate_mode
		jalr r0 r7 #0


	// -------------------------------------------------------------------------
	// Flip Cell State
	// -------------------------------------------------------------------------
	.flip_cell:
		// memory offset = (y * 64) + x
		movi r2 cursor_y
		lw r1 [r2 + #0]
		add r1 r1 r1 // * 2
		add r1 r1 r1 // * 4
		add r1 r1 r1 // * 8
		add r1 r1 r1 // * 16
		add r1 r1 r1 // * 32
		add r1 r1 r1 // * 64

		movi r2 cursor_x
		lw r2 [r2 + #0]
		add r1 r1 r2 // r1 = (y * 64) + x
		add r1 r4 r1 // pointer = active_grid + offset

		// Toggle: if 1 -> 0, if 0 -> 1
		lw r2 [r1 + #0]
		beq r2 r0 .make_alive
		sw r0 [r1 + #0]
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.make_alive:
		movi r2 #1
		sw r2 [r1 + #0]
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	// -------------------------------------------------------------------------
	// Evaluation & Rendering
	// -------------------------------------------------------------------------
	.evaluate_mode:
		movi r2 is_paused
		lw r2 [r2 + #0]
		// If paused, jump straight to rendering (unless N was pressed!)
		bne r2 r0 .render_only

	.advance_generation:
		mov r1 r4
		mov r2 r5
		call step_generation

		// Swap double buffers
		mov r1 r4
		mov r4 r5
		mov r5 r1

		movi r7 .render_only
		jalr r0 r7 #0

	.do_single_step:
		// Forced step triggered by 'N' key
		movi r7 .advance_generation
		jalr r0 r7 #0

	.render_only:
		// 1. Draw the active generation grid to screen
		mov r1 r4
		call render_grid

		// 2. If paused, draw Editor overlays!
		movi r2 is_paused
		lw r2 [r2 + #0]
		beq r2 r0 .draw_border_running

	.draw_cursor:
		// Toggle blink tick
		movi r3 blink_tick
		lw r2 [r3 + #0]
		addi r2 r2 #1
		sw r2 [r3 + #0]

		// Blink on every 4th frame (for a retro feeling)
		movi r1 #4
		and r2 r2 r1
		beq r2 r0 .draw_border_paused

		// Draw Red cursor at (cursor_x, cursor_y)
		movi r1 cursor_x
		lw r1 [r1 + #0]
		movi r2 cursor_y
		lw r2 [r2 + #0]
		movi r3 0xF800 // Bright Red
		call gfx_draw_pixel

	.draw_border_paused:
		// Draw Amber outline perimeter
		push r4
		push r5

		movi r1 #0
		movi r2 #0
		movi r3 #64
		movi r4 #64
		movi r5 0xFD20 // Amber / Orange
		call gfx_draw_rect

		pop r5
		pop r4

		movi r7 .present
		jalr r0 r7 #0

	.draw_border_running:
		// Draw Black outline perimeter
		push r4
		push r5

		movi r1 #0
		movi r2 #0
		movi r3 #64
		movi r4 #64
		movi r5 0x0000 // Black
		call gfx_draw_rect

		pop r5
		pop r4

	.present:
		call gfx_present
		movi r7 .sim_loop
		jalr r0 r7 #0


// =============================================================================
// Subroutine: clear_grids()
// =============================================================================
clear_grids:
	push r7
	push r4
	movi r1 grid_a
	clr r2
	movi r3 #4096
	call mem_set
	movi r1 grid_b
	clr r2
	movi r3 #4096
	call mem_set
	pop r4
	pop r7
	ret

// =============================================================================
// Subroutine: seed_grid()
// Seeds ONLY inner 62x62 cells
// =============================================================================
seed_grid:
	push r7
	push r4
	push r5
	push r1

	call clear_grids

	// r4 = grid_a + 65 (row 1, col 1)
	movi r4 grid_a
	addi r4 r4 #32
	addi r4 r4 #33

	movi r5 #1

	.seed_y_loop:
		movi r1 #63
		beq r5 r1 .seed_done

		movi r1 #62
		mov r2 r4
		movi r3 0x4000 // 25% threshold
		call random_weighted_array

		// Advance r4 to next row col 1
		addi r4 r4 #32
		addi r4 r4 #32
		addi r5 r5 #1
		beq r0 r0 .seed_y_loop

	.seed_done:
		pop r1
		pop r5
		pop r4
		pop r7
		ret

// =============================================================================
// Subroutine: render_grid(r1: ShortArray)
// =============================================================================
render_grid:
	push r7
	push r4
	push r5

	mov r4 r1
	addi r4 r4 #32
	addi r4 r4 #33

	movi r5 #1
	movi r7 0xFF07 // MMIO base

	.render_y_loop:
		movi r1 #63
		beq r5 r1 .render_done

		movi r1 #1
		sw r1 [r7 + #0] // DD_X = 1
		sw r5 [r7 + #1] // DD_Y = y
		movi r3 #62     // x from 1 to 62

	.render_x_loop:
		beq r3 r0 .render_row_done
		lw r1 [r4 + #0]
		addi r4 r4 #1
		beq r1 r0 .draw_black

	.draw_green:
		movi r2 0x07E0 // Neon Green
		sw r2 [r7 + #2]
		beq r0 r0 .next_cell

	.draw_black:
		sw r0 [r7 + #2]

	.next_cell:
		subi r3 r3 #1
		beq r0 r0 .render_x_loop

	.render_row_done:
		addi r4 r4 #2
		addi r5 r5 #1
		beq r0 r0 .render_y_loop

	.render_done:
		pop r5
		pop r4
		pop r7
		ret

// =============================================================================
// Subroutine: step_generation(r1 = current, r2 = next)
// =============================================================================
step_generation:
	push r7
	push r4
	push r5

	// Local frame setup
	mov r5 r6
	addi r6 r6 #4

	sw r1 [r5 + #0] // current
	sw r2 [r5 + #1] // next

	movi r1 #1
	sw r1 [r5 + #3] // y = 1

	.row_loop:
		lw r1 [r5 + #3]
		movi r2 #63
		bne r1 r2 .continue_row

		movi r7 .step_done
		jalr r0 r7 #0

	.continue_row:
		mov r3 r1
		add r3 r3 r3
		add r3 r3 r3
		add r3 r3 r3
		add r3 r3 r3
		add r3 r3 r3
		add r3 r3 r3 // r3 = y * 64

		lw r1 [r5 + #0]
		add r4 r1 r3
		addi r4 r4 #1 // r_mid

		subi r7 r4 #64 // r_top

		addi r1 r4 #32
		addi r1 r1 #32 // r_bot

		lw r2 [r5 + #1]
		add r2 r2 r3
		addi r2 r2 #1
		sw r2 [r5 + #2] // r_next

		push r1 // [r6 - 1] = r_bot

		movi r3 #62 // r3 = column counter

	.col_loop:
		// Sum 8 neighbours
		lw r1 [r7 + #-1]
		lw r2 [r7 + #0]
		add r1 r1 r2
		lw r2 [r7 + #1]
		add r1 r1 r2

		lw r2 [r4 + #-1]
		add r1 r1 r2
		lw r2 [r4 + #1]
		add r1 r1 r2

		lw r2 [r6 + #-1]
		lw r2 [r2 + #-1]
		add r1 r1 r2
		lw r2 [r6 + #-1]
		lw r2 [r2 + #0]
		add r1 r1 r2
		lw r2 [r6 + #-1]
		lw r2 [r2 + #1]
		add r1 r1 r2

		// Get bitmask
		movi r2 pow2_table
		add r2 r2 r1
		lw r2 [r2 + #0]

		lw r1 [r4 + #0]
		beq r1 r0 .check_birth

	.check_survival:
		push r3 // SAVE COUNTER!
		movi r3 rule_survival
		lw r1 [r3 + #0]
		pop r3  // RESTORE COUNTER!
		and r1 r1 r2
		bne r1 r0 .cell_alive
		beq r0 r0 .cell_dead

	.check_birth:
		push r3 // SAVE COUNTER!
		movi r3 rule_birth
		lw r1 [r3 + #0]
		pop r3  // RESTORE COUNTER!
		and r1 r1 r2
		bne r1 r0 .cell_alive
		beq r0 r0 .cell_dead

	.cell_alive:
		lw r2 [r5 + #2]
		movi r1 #1
		sw r1 [r2 + #0]
		addi r2 r2 #1
		sw r2 [r5 + #2]
		beq r0 r0 .advance_cell

	.cell_dead:
		lw r2 [r5 + #2]
		sw r0 [r2 + #0]
		addi r2 r2 #1
		sw r2 [r5 + #2]

	.advance_cell:
		addi r7 r7 #1 // r_top++
		addi r4 r4 #1 // r_mid++

		lw r2 [r6 + #-1]
		addi r2 r2 #1
		sw r2 [r6 + #-1] // r_bot++

		subi r3 r3 #1

		beq r3 r0 .row_finished
		movi r1 .col_loop // SAFE TRAMPOLINE
		jalr r0 r1 #0

	.row_finished:
		pop r1
		lw r1 [r5 + #3]
		addi r1 r1 #1
		sw r1 [r5 + #3]
		movi r7 .row_loop
		jalr r0 r7 #0

	.step_done:
		subi r6 r6 #4
		pop r5
		pop r4
		pop r7
		ret

// =============================================================================
// Subroutine: parse_rule_string
// Correctly parses NO-NULL-TERMINATOR strings
// =============================================================================
parse_rule_string:
	push r7
	push r4
	push r5

	mov r4 r1
	movi r5 rule_birth

	movi r2 rule_birth
	sw r0 [r2 + #0]
	movi r2 rule_survival
	sw r0 [r2 + #0]

	.parse_loop:
		lw r1 [r4 + #0]
		bne r1 r0 .continue_parse
		movi r7 .parse_done
		jalr r0 r7 #0

	.continue_parse:
		addi r4 r4 #1

		movi r2 #48
		blt r1 r2 .check_letters
		movi r2 #56
		bgt r1 r2 .check_letters

		subi r1 r1 #48
		movi r2 pow2_table
		add r2 r2 r1
		lw r2 [r2 + #0]
		lw r3 [r5 + #0]
		or r3 r3 r2
		sw r3 [r5 + #0]

		movi r7 .parse_loop
		jalr r0 r7 #0

	.check_letters:
		movi r2 #66
		beq r1 r2 .set_mode_birth
		movi r2 #98
		beq r1 r2 .set_mode_birth

		movi r2 #83
		beq r1 r2 .set_mode_survival
		movi r2 #115
		beq r1 r2 .set_mode_survival

		movi r7 .parse_loop
		jalr r0 r7 #0

	.set_mode_birth:
		movi r5 rule_birth
		movi r7 .parse_loop
		jalr r0 r7 #0

	.set_mode_survival:
		movi r5 rule_survival
		movi r7 .parse_loop
		jalr r0 r7 #0

	.parse_done:
		pop r5
		pop r4
		pop r7
		ret

// =============================================================================
// DATA SECTION
// =============================================================================
rule_conway:    .fill "B3/S23"
rule_highlife:  .fill "B36/S23"
rule_day_night: .fill "B3678/S34678"
rule_seeds:     .fill "B2/S"
rule_diamoeba:  .fill "B35678/S5678"

pow2_table:     .fill { 1 2 4 8 16 32 64 128 256 }

is_paused:      .fill 1
cursor_x:       .fill 31
cursor_y:       .fill 31
blink_tick:     .fill 0
prev_gpad:      .fill 0

rule_birth:     .space 1
rule_survival:  .space 1

grid_a:         .space 4096
grid_b:         .space 4096

stack:          .space 100