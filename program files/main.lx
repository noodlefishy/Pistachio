main:
	movi r6 stack

//	movi r1 0x2104
	call gfx_init

	movi r1 #4 // X
	movi r2 #4 // Y
	movi r3 score_text
	movi r4 0x07FF // Cyan color
	call gfx_draw_string
	call gfx_present




	halt

	// 2. Draw 4x4 Heart sprite at (10, 10)
	movi r1 #10 // X
	movi r2 #10 // Y
	movi r3 #4 // Width
	movi r4 #4 // Height
	movi r5 my_sprite // Pointer to sprite data
	call gfx_draw_sprite

	// 3. Draw a second heart at (30, 20)
	movi r1 #30 // X
	movi r2 #20 // Y
	movi r3 #4 // Width
	movi r4 #4 // Height
	movi r5 my_sprite
	call gfx_draw_sprite

	// 5. Blit everything to the window!
	call gfx_present

	call gfx_wait_until_close
	halt





stack:
	.space #100

my_sprite:
	.fill { 0x0000 0x0000 0xF800 0xF800 }
	.fill { 0x0000 0x0000 0xFFFF 0xF81F }
	.fill { 0xF800 0xF800 0xF800 0x0000 }
	.fill { 0xF800 0x0000 0xF800 0x0000 }
score_text:
	.fill "I HATE STEFAN"