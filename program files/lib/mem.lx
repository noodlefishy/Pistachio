// =============================================================================
// MODULE: Memory Block Operations (lib/mem.lx)
//
// Description:
//   Provides efficient memory block operations (mem_set, mem_cpy, mem_cmp, mem_mov)
//   for contiguous 16-bit word buffers in RAM.
// =============================================================================

// =============================================================================
// Subroutine: mem_set(r1: ShortArray, r2: Short, r3: Short) -> r1: ShortArray
//
// Description:
//   Fills a memory buffer with a constant 16-bit value.
//
// Inputs:
//   r1: ShortArray = Destination buffer pointer
//   r2: Short = Value to write
//   r3: Short = Word count
//
// Outputs:
//   r1: ShortArray = Original destination pointer
// =============================================================================
mem_set:
	push r4
	movi r4 0xFF30
	sw r2 [r4 + #0]  // Source Value
	sw r1 [r4 + #1]  // Destination Address
	sw r3 [r4 + #2]  // Length
	movi r2 #2
	sw r2 [r4 + #3]  // Fire Command 2 (MEM_FILL)
	pop r4
	ret



// =============================================================================
// Subroutine: mem_cmp(r1: ShortArray, r2: ShortArray, r3: Short) -> r1: Short
//
// Description:
//   Compares two memory blocks word by word.
//
// Outputs:
//   r1: Short = 0 if identical, or difference of first mismatching words.
// =============================================================================
mem_cmp:
	push r4
	push r5

	.cmp_loop:
		beq r3 r0 .cmp_equal
		lw r4 [r1 + #0]
		lw r5 [r2 + #0]

		bne r4 r5 .cmp_mismatch

		addi r1 r1 #1
		addi r2 r2 #1
		subi r3 r3 #1
		beq r0 r0 .cmp_loop

	.cmp_mismatch:
		sub r1 r4 r5
		pop r5
		pop r4
		ret

	.cmp_equal:
		clr r1
		pop r5
		pop r4
		ret


// =============================================================================
// Subroutine: mem_mov(r1: ShortArray, r2: ShortArray, r3: Short) -> r1: ShortArray
//
// Description:
//   Safely copies a memory block, handling overlapping source and destination regions.
// =============================================================================
mem_cpy:
mem_mov:
	push r4
	movi r4 0xFF30
	sw r2 [r4 + #0]  // Source Address
	sw r1 [r4 + #1]  // Destination Address
	sw r3 [r4 + #2]  // Length
	movi r2 #1
	sw r2 [r4 + #3]  // Fire Command 1 (MEM_COPY)
	pop r4
	ret
