// =============================================================================
// MODULE: SIMD Packing Accelerator Driver (lib/packing.lx)
//
// Description:
//   Driver for the Pistachio SIMD Packing Accelerator (MMIO 0xFF60..0xFF69).
//   Provides parallel vector arithmetic (padd, psub, pmul, padd8, pdot).
// =============================================================================

// =============================================================================
// Subroutine: padd(r1: ShortArray, r2: ShortArray, r3: ShortArray) -> Unit
//
// Description:
//   Performs parallel 16-bit addition on 4-word vectors.
// =============================================================================
padd:
	push r7
	push r4
	movi r4 #1 // Command 1 = PADD
	call pack_exec_4
	pop r4
	pop r7
	ret


// =============================================================================
// Subroutine: psub(r1: ShortArray, r2: ShortArray, r3: ShortArray) -> Unit
//
// Description:
//   Performs parallel 16-bit subtraction on 4-word vectors.
// =============================================================================
psub:
	push r7
	push r4
	movi r4 #2 // Command 2 = PSUB
	call pack_exec_4
	pop r4
	pop r7
	ret


// =============================================================================
// Subroutine: pmul(r1: ShortArray, r2: ShortArray, r3: ShortArray) -> Unit
//
// Description:
//   Performs parallel 16-bit multiplication on 4-word vectors.
// =============================================================================
pmul:
	push r7
	push r4
	movi r4 #3 // Command 3 = PMUL
	call pack_exec_4
	pop r4
	pop r7
	ret


// =============================================================================
// Subroutine: padd8(r1: UShortArray, r2: UShortArray, r3: UShortArray) -> Unit
//
// Description:
//   Performs parallel 8-bit packed addition on 4-word vectors.
// =============================================================================
padd8:
	push r7
	push r4
	movi r4 #5 // Command 5 = PADD8
	call pack_exec_4
	pop r4
	pop r7
	ret


// =============================================================================
// Subroutine: pdot(r1: ShortArray, r2: ShortArray) -> r1: Short
//
// Description:
//   Computes the 16-bit scalar dot product of two 4-word vectors.
// =============================================================================
pdot:
	push r7
	push r4
	push r5

	movi r5 0xFF60

	lw r7 [r1 + #0]
	sw r7 [r5 + #0]
	lw r7 [r1 + #1]
	sw r7 [r5 + #1]
	lw r7 [r1 + #2]
	sw r7 [r5 + #2]
	lw r7 [r1 + #3]
	sw r7 [r5 + #3]

	lw r7 [r2 + #0]
	sw r7 [r5 + #4]
	lw r7 [r2 + #1]
	sw r7 [r5 + #5]
	lw r7 [r2 + #2]
	sw r7 [r5 + #6]
	lw r7 [r2 + #3]
	sw r7 [r5 + #7]

	movi r4 #4
	sw r4 [r5 + #8]

	lw r1 [r5 + #9]

	pop r5
	pop r4
	pop r7
	ret


// -----------------------------------------------------------------------------
// pack_exec_4(r1: ShortArray, r2: ShortArray, r3: ShortArray, r4: Short) -> Unit
// Internal MMIO driver for 4-word packing instructions.
// -----------------------------------------------------------------------------
pack_exec_4:
	push r7
	push r4
	push r5

	movi r5 0xFF60

	lw r7 [r1 + #0]
	sw r7 [r5 + #0]
	lw r7 [r1 + #1]
	sw r7 [r5 + #1]
	lw r7 [r1 + #2]
	sw r7 [r5 + #2]
	lw r7 [r1 + #3]
	sw r7 [r5 + #3]

	lw r7 [r2 + #0]
	sw r7 [r5 + #4]
	lw r7 [r2 + #1]
	sw r7 [r5 + #5]
	lw r7 [r2 + #2]
	sw r7 [r5 + #6]
	lw r7 [r2 + #3]
	sw r7 [r5 + #7]

	sw r4 [r5 + #8]

	lw r7 [r5 + #9]
	sw r7 [r3 + #0]
	lw r7 [r5 + #10]
	sw r7 [r3 + #1]
	lw r7 [r5 + #11]
	sw r7 [r3 + #2]
	lw r7 [r5 + #12]
	sw r7 [r3 + #3]

	pop r5
	pop r4
	pop r7
	ret
