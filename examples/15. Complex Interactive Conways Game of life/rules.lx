// ===
// Module: Rule Parser and Presenter
// ===

// =============================================================================
// Subroutine: parse_rule_string(r1: String) -> Unit
// =============================================================================
parse_rule_string:
	push r7
	push r4
	push r5

	mov r4 r1
	movi r5 rule_birth

	movi r2 rule_birth
	sw r0 [r2 + #0]
	movi r2 rule_survival
	sw r0 [r2 + #0]

	.parse_loop:
		lw r1 [r4 + #0]
		bne r1 r0 .continue_parse
		movi r7 .parse_done
		jalr r0 r7 #0

	.continue_parse:
		addi r4 r4 #1

		movi r2 #48
		blt r1 r2 .check_letters
		movi r2 #56
		bgt r1 r2 .check_letters

		subi r1 r1 #48
		movi r2 pow2_table
		add r2 r2 r1
		lw r2 [r2 + #0]
		lw r3 [r5 + #0]
		or r3 r3 r2
		sw r3 [r5 + #0]

		movi r7 .parse_loop
		jalr r0 r7 #0

	.check_letters:
		movi r2 #66
		beq r1 r2 .set_mode_birth
		movi r2 #98
		beq r1 r2 .set_mode_birth

		movi r2 #83
		beq r1 r2 .set_mode_survival
		movi r2 #115
		beq r1 r2 .set_mode_survival

		movi r7 .parse_loop
		jalr r0 r7 #0

	.set_mode_birth:
		movi r5 rule_birth
		movi r7 .parse_loop
		jalr r0 r7 #0

	.set_mode_survival:
		movi r5 rule_survival
		movi r7 .parse_loop
		jalr r0 r7 #0

	.parse_done:
		pop r5
		pop r4
		pop r7
		ret

// DATA SECTION: Rules & Presets

rule_birth:             .space 1
rule_survival:          .space 1

