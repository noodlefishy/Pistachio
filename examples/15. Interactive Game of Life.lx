// =============================================================================
// Example 15: Interactive Game of Life V2 (Modal Editor)
// Controls: WASD/Arrows (Move), E (Draw/Erase), Space/P (Pause), N (Step),
//           R (Reseed), C (Clear), Q (Toggle Age Mode),
//           H (Toggle Hologram Blueprint), T (Stamp), Y (Cycle Stamp)
// Run with: 	./lx -i "examples/15. Interactive Game of Life.lx" "program files/lib" "program files/assets"
// =============================================================================

main:
	movi r6 stack
	call heap_init
	call gfx_init

	// Set target VSYNC FPS (30 FPS gives a great natural cursor speed)
	movi r2 0xFF0C
	movi r1 #30
	sw r1 [r2 + #0]

	clr r1
	call gfx_clear
	call gfx_present

	movi r1 rule_pointer
	lw r1 [r1 + #0]
	call parse_rule_string

	// r4 = active grid, r5 = back buffer
	movi r4 grid_a
	movi r5 grid_b

	call seed_grid

	// =========================================================================
	// Main Simulation Loop (State Machine)
	// =========================================================================
	.sim_loop:
		movi r2 0xFF06 // DD_STUS
		lw r1 [r2 + #0]
		bne r1 r0 .poll_input
		halt // Safely shutdown

	.poll_input:
		movi r2 0xFF0B
		lw r1 [r2 + #0]

		bne r1 r0 .handle_key

		// Arrow Key Polling (0xFF0A)
		movi r2 is_paused
		lw r2 [r2 + #0]
		beq r2 r0 .jmp_eval_mode

		movi r7 .poll_arrows
		jalr r0 r7 #0

	.jmp_eval_mode:
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.handle_key:
		// Convert lowercase to uppercase
		movi r2 #97  // 'a'
		blt r1 r2 .route_key
		movi r2 #122 // 'z'
		bgt r1 r2 .route_key
		subi r1 r1 #32

	.route_key:
		// P (80), Space (32) -> Pause
		movi r2 #80
		beq r1 r2 .jmp_toggle
		movi r2 #32
		beq r1 r2 .jmp_toggle

		// 'T' (84) -> Stamp active sprite
		movi r2 #84
		beq r1 r2 .jmp_stamp

		// 'Y' (89) -> Cycle to next sprite
		movi r2 #89
		beq r1 r2 .jmp_cycle_stamp

		// 'H' (72) -> Toggle Hologram Blueprint
		movi r2 #72
		beq r1 r2 .jmp_hologram

		// R (82) -> Reseed, C (67) -> Clear, Q (81) -> Age Mode
		movi r2 #82
		beq r1 r2 .jmp_reseed
		movi r2 #67
		beq r1 r2 .jmp_clear
		movi r2 #81
		beq r1 r2 .jmp_age

		// Editor Keys (Only if paused)
		movi r2 is_paused
		lw r2 [r2 + #0]
		beq r2 r0 .end_routing

		// W (87), S (83), A (65), D (68)
		movi r2 #87
		beq r1 r2 .jmp_up
		movi r2 #83
		beq r1 r2 .jmp_down
		movi r2 #65
		beq r1 r2 .jmp_left
		movi r2 #68
		beq r1 r2 .jmp_right

		// N (78) -> Step
		movi r2 #78
		beq r1 r2 .jmp_step

	.end_routing:
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	// -------------------------------------------------------------------------
	// Dispatch Trampolines (Keeps relative branches strictly within bounds)
	// -------------------------------------------------------------------------
	.jmp_toggle:
		movi r7 .toggle_pause
		jalr r0 r7 #0
	.jmp_stamp:
		movi r7 .do_stamp
		jalr r0 r7 #0
	.jmp_cycle_stamp:
		movi r7 .cycle_stamp
		jalr r0 r7 #0
	.jmp_hologram:
		movi r7 .toggle_hologram
		jalr r0 r7 #0
	.jmp_reseed:
		movi r7 .do_reseed
		jalr r0 r7 #0
	.jmp_clear:
		movi r7 .do_clear
		jalr r0 r7 #0
	.jmp_age:
		movi r7 .toggle_age
		jalr r0 r7 #0
	.jmp_up:
		movi r7 .cursor_up
		jalr r0 r7 #0
	.jmp_down:
		movi r7 .cursor_down
		jalr r0 r7 #0
	.jmp_left:
		movi r7 .cursor_left
		jalr r0 r7 #0
	.jmp_right:
		movi r7 .cursor_right
		jalr r0 r7 #0
	.jmp_step:
		movi r7 .do_single_step
		jalr r0 r7 #0

	// -------------------------------------------------------------------------
	// Arrow Keys (Continuous Polling)
	// -------------------------------------------------------------------------
	.poll_arrows:
		movi r2 0xFF0A
		lw r1 [r2 + #0]

		// Bit 0 (0x0001): Up
		movi r2 #1
		and r3 r1 r2
		bne r3 r0 .jmp_up
		// Bit 1 (0x0002): Down
		movi r2 #2
		and r3 r1 r2
		bne r3 r0 .jmp_down
		// Bit 2 (0x0004): Left
		movi r2 #4
		and r3 r1 r2
		bne r3 r0 .jmp_left
		// Bit 3 (0x0008): Right
		movi r2 #8
		and r3 r1 r2
		bne r3 r0 .jmp_right

		beq r0 r0 .check_brush

	// -------------------------------------------------------------------------
	// Smart Brush Polling (Tapping/Holding 'E' toggles, paints, or erases)
	// -------------------------------------------------------------------------
	.check_brush:
		movi r2 0xFF0A
		lw r1 [r2 + #0] // r1 = Gamepad state

		// Check Bit 5 (0x0020 = 32): E, X, or Shift
		movi r2 #32
		and r3 r1 r2

		movi r2 prev_e
		lw r7 [r2 + #0] // r7 = previous state of E

		beq r3 r0 .e_is_up

	.e_is_down:
		movi r1 #1
		sw r1 [r2 + #0] // prev_e = 1

		// If previous state was 0, this is a FRESH PRESS! Decide brush mode
		beq r7 r0 .fresh_e_press

		// Otherwise, E is being HELD/DRAGGED -> apply active mode
		movi r7 .apply_brush
		jalr r0 r7 #0

	.e_is_up:
		sw r0 [r2 + #0] // prev_e = 0
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.fresh_e_press:
		// Calculate address of cell under cursor
		movi r2 cursor_y
		lw r3 [r2 + #0]
		add r3 r3 r3 // * 2
		add r3 r3 r3 // * 4
		add r3 r3 r3 // * 8
		add r3 r3 r3 // * 16
		add r3 r3 r3 // * 32
		add r3 r3 r3 // * 64
		movi r2 cursor_x
		lw r2 [r2 + #0]
		add r3 r3 r2
		add r1 r4 r3 // r1 = &active_grid[offset]

		// Check if cell is currently ALIVE or DEAD
		lw r2 [r1 + #0]
		movi r1 brush_mode
		beq r2 r0 .set_mode_paint

	.set_mode_erase:
		// Cell was alive -> Set mode to ERASE (0)
		sw r0 [r1 + #0]
		movi r7 .apply_brush
		jalr r0 r7 #0

	.set_mode_paint:
		// Cell was dead -> Set mode to PAINT (1)
		movi r2 #1
		sw r2 [r1 + #0]

	.apply_brush:
		movi r2 brush_mode
		lw r2 [r2 + #0]
		beq r2 r0 .jmp_erase
		movi r7 .jmp_paint
		jalr r0 r7 #0

	.jmp_paint:
		movi r7 .paint_cell
		jalr r0 r7 #0
	.jmp_erase:
		movi r7 .erase_cell
		jalr r0 r7 #0

	// -------------------------------------------------------------------------
	// Cursor Movement
	// -------------------------------------------------------------------------
	.cursor_up:
		movi r2 cursor_y
		lw r3 [r2 + #0]
		movi r1 #1
		beq r3 r1 .clamp_abort
		subi r3 r3 #1
		sw r3 [r2 + #0]
		movi r7 .check_brush
		jalr r0 r7 #0

	.cursor_down:
		movi r2 cursor_y
		lw r3 [r2 + #0]
		movi r1 #62
		beq r3 r1 .clamp_abort
		addi r3 r3 #1
		sw r3 [r2 + #0]
		movi r7 .check_brush
		jalr r0 r7 #0

	.cursor_left:
		movi r2 cursor_x
		lw r3 [r2 + #0]
		movi r1 #1
		beq r3 r1 .clamp_abort
		subi r3 r3 #1
		sw r3 [r2 + #0]
		movi r7 .check_brush
		jalr r0 r7 #0

	.cursor_right:
		movi r2 cursor_x
		lw r3 [r2 + #0]
		movi r1 #62
		beq r3 r1 .clamp_abort
		addi r3 r3 #1
		sw r3 [r2 + #0]
		movi r7 .check_brush
		jalr r0 r7 #0

	.clamp_abort:
		movi r7 .check_brush
		jalr r0 r7 #0

	// -------------------------------------------------------------------------
	// Cell Paint / Erase Workers
	// -------------------------------------------------------------------------
	.paint_cell:
		movi r2 cursor_y
		lw r3 [r2 + #0]
		add r3 r3 r3 // * 2
		add r3 r3 r3 // * 4
		add r3 r3 r3 // * 8
		add r3 r3 r3 // * 16
		add r3 r3 r3 // * 32
		add r3 r3 r3 // * 64
		movi r2 cursor_x
		lw r2 [r2 + #0]
		add r3 r3 r2
		add r1 r4 r3

		movi r2 #1
		sw r2 [r1 + #0] // SET ALIVE

		movi r1 age_grid
		add r1 r1 r3
		movi r2 #1
		sw r2 [r1 + #0] // SET AGE = Newborn

		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.erase_cell:
		movi r2 cursor_y
		lw r3 [r2 + #0]
		add r3 r3 r3 // * 2
		add r3 r3 r3 // * 4
		add r3 r3 r3 // * 8
		add r3 r3 r3 // * 16
		add r3 r3 r3 // * 32
		add r3 r3 r3 // * 64
		movi r2 cursor_x
		lw r2 [r2 + #0]
		add r3 r3 r2
		add r1 r4 r3

		sw r0 [r1 + #0] // SET DEAD

		movi r1 age_grid
		add r1 r1 r3
		movi r2 #-1
		sw r2 [r1 + #0] // SET AGE = Just Died

		movi r7 .evaluate_mode
		jalr r0 r7 #0

	// -------------------------------------------------------------------------
	// Action Handlers
	// -------------------------------------------------------------------------
	.do_reseed:
		movi r4 grid_a
		movi r5 grid_b
		call seed_grid
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.do_clear:
		movi r4 grid_a
		movi r5 grid_b
		call clear_grids
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.toggle_hologram:
		movi r2 show_ghost
		lw r3 [r2 + #0]
		beq r3 r0 .enable_ghost
		sw r0 [r2 + #0] // Turn OFF
		movi r7 .evaluate_mode
		jalr r0 r7 #0
	.enable_ghost:
		movi r3 #1
		sw r3 [r2 + #0] // Turn ON
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.cycle_stamp:
		movi r2 current_stamp_idx
		lw r1 [r2 + #0]
		addi r1 r1 #1
		movi r3 #4 // NUM_STAMPS
		bne r1 r3 .save_stamp_idx
		clr r1     // Wrap back to 0!
	.save_stamp_idx:
		sw r1 [r2 + #0]
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.do_stamp:
		// PRESERVE r5 (r5 is grid_b in main!)
		push r5

		movi r2 current_stamp_idx
		lw r1 [r2 + #0]
		movi r2 stamp_roster
		add r2 r2 r1
		lw r5 [r2 + #0] // r5 = sprite pattern

		clr r1 // dy

	.stamp_row_loop:
		movi r2 #8
		beq r1 r2 .stamp_finished

		clr r2 // dx
		beq r0 r0 .stamp_col_loop

	.stamp_finished:
		pop r5 // RESTORE r5! (Buffer pointer intact!)
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.stamp_row_next:
		addi r1 r1 #1 // dy++
		beq r0 r0 .stamp_row_loop

	.stamp_col_loop:
		movi r3 #8
		beq r2 r3 .stamp_row_next

		mov r3 r1
		add r3 r3 r3 // * 2
		add r3 r3 r3 // * 4
		add r3 r3 r3 // * 8
		add r3 r3 r2 // + dx
		add r3 r5 r3
		lw r3 [r3 + #0]

		bne r3 r0 .stamp_draw_pixel
		movi r7 .stamp_skip_pixel
		jalr r0 r7 #0

	.stamp_draw_pixel:
		push r1
		push r2

		movi r7 cursor_y
		lw r7 [r7 + #0]
		add r1 r7 r1 // target_y

		movi r7 #62
		bgt r1 r7 .stamp_pop_skip

		movi r7 cursor_x
		lw r7 [r7 + #0]
		add r2 r7 r2 // target_x

		movi r7 #62
		bgt r2 r7 .stamp_pop_skip

		add r1 r1 r1 // * 2
		add r1 r1 r1 // * 4
		add r1 r1 r1 // * 8
		add r1 r1 r1 // * 16
		add r1 r1 r1 // * 32
		add r1 r1 r1 // * 64
		add r1 r1 r2 // offset

		// Write ALIVE (1) to active_grid
		add r2 r4 r1
		movi r3 #1
		sw r3 [r2 + #0]

		// Set age to 1 (Newborn) in age_grid
		movi r2 age_grid
		add r2 r2 r1
		movi r3 #1
		sw r3 [r2 + #0]

	.stamp_pop_skip:
		pop r2
		pop r1

	.stamp_skip_pixel:
		addi r2 r2 #1 // dx++
		movi r7 .stamp_col_loop
		jalr r0 r7 #0

	.toggle_age:
		movi r2 is_age_mode
		lw r3 [r2 + #0]
		beq r3 r0 .set_age
		sw r0 [r2 + #0]
		movi r7 .evaluate_mode
		jalr r0 r7 #0
	.set_age:
		movi r3 #1
		sw r3 [r2 + #0]
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	.toggle_pause:
		movi r2 is_paused
		lw r3 [r2 + #0]
		beq r3 r0 .set_paused
		sw r0 [r2 + #0] // Unpause
		movi r7 .evaluate_mode
		jalr r0 r7 #0
	.set_paused:
		movi r3 #1
		sw r3 [r2 + #0] // Pause
		movi r7 .evaluate_mode
		jalr r0 r7 #0

	// -------------------------------------------------------------------------
	// Evaluation & Rendering
	// -------------------------------------------------------------------------
	.evaluate_mode:
		movi r2 is_paused
		lw r2 [r2 + #0]
		bne r2 r0 .render_only

	.advance_generation:
		mov r1 r4
		mov r2 r5
		call step_generation

		mov r1 r5        // r1 = newly calculated generation
		movi r2 age_grid // r2 = age_grid
		call update_age_grid

		// Swap double buffers
		mov r1 r4
		mov r4 r5
		mov r5 r1

		movi r7 .render_only
		jalr r0 r7 #0

	.do_single_step:
		movi r7 .advance_generation
		jalr r0 r7 #0

	.render_only:
		mov r1 r4
		call render_grid

		movi r2 is_paused
		lw r2 [r2 + #0]

		// TRAMPOLINE: Long jump over cursor/hologram if running!
		bne r2 r0 .draw_cursor
		movi r7 .draw_border_running
		jalr r0 r7 #0

	.draw_cursor:
		// Check if Hologram is turned ON
		movi r2 show_ghost
		lw r2 [r2 + #0]
		beq r2 r0 .draw_anchor_dot // If OFF, skip straight to red anchor!

		// Draw Hologram Blueprint
		push r5 // Preserve r5 (grid_b)!

		movi r2 current_stamp_idx
		lw r1 [r2 + #0]
		movi r2 stamp_roster
		add r2 r2 r1
		lw r5 [r2 + #0] // r5 = active 8x8 sprite

		clr r1 // dy

	.ghost_row:
		movi r2 #8
		beq r1 r2 .ghost_done
		clr r2 // dx

	.ghost_col:
		movi r3 #8
		beq r2 r3 .ghost_next_row

		// Read sprite pixel: r5[dy * 8 + dx]
		mov r3 r1
		add r3 r3 r3
		add r3 r3 r3
		add r3 r3 r3
		add r3 r3 r2
		add r3 r5 r3
		lw r3 [r3 + #0]
		beq r3 r0 .ghost_skip

		// Correct coordinates: target_x = cursor_x + dx, target_y = cursor_y + dy
		push r1 // save dy
		push r2 // save dx

		movi r7 cursor_y
		lw r7 [r7 + #0]
		add r2 r7 r1 // target_y = cursor_y + dy

		pop r1       // r1 = dx
		push r1      // balance stack

		movi r7 cursor_x
		lw r7 [r7 + #0]
		add r1 r7 r1 // target_x = cursor_x + dx

		movi r3 0x07FF // Faint Cyan Hologram!
		call gfx_draw_pixel

		pop r2 // restore dx
		pop r1 // restore dy

	.ghost_skip:
		addi r2 r2 #1
		beq r0 r0 .ghost_col

	.ghost_next_row:
		addi r1 r1 #1
		beq r0 r0 .ghost_row

	.ghost_done:
		pop r5 // Restore r5 (grid_b)!

	.draw_anchor_dot:
		// Draw red cursor anchor
		movi r1 cursor_x
		lw r1 [r1 + #0]
		movi r2 cursor_y
		lw r2 [r2 + #0]
		movi r3 0xF800 // Bright Red Anchor
		call gfx_draw_pixel
		beq r0 r0 .draw_border_paused

	.draw_border_running:
		push r4
		push r5
		movi r1 #0
		movi r2 #0
		movi r3 #64
		movi r4 #64
		movi r5 0x0000 // Black
		call gfx_draw_rect
		pop r5
		pop r4
		beq r0 r0 .present

	.draw_border_paused:
		push r4
		push r5
		movi r1 #0
		movi r2 #0
		movi r3 #64
		movi r4 #64
		movi r5 0xFD20 // Amber
		call gfx_draw_rect
		pop r5
		pop r4

	.present:
		call gfx_present

		// VSYNC DELAY
		movi r2 0xFF0C
		lw r0 [r2 + #0]

		movi r7 .sim_loop
		jalr r0 r7 #0

// =============================================================================
// Subroutine: clear_grids()
// Uses Hardware DMA to instantly wipe grid_a, grid_b, and age_grid!
// =============================================================================
clear_grids:
	movi r2 0xFF30
	sw r0 [r2 + #0] // Fill value = 0
	movi r1 #4096
	sw r1 [r2 + #2]

	movi r1 grid_a
	sw r1 [r2 + #1]
	movi r1 #2
	sw r1 [r2 + #3] // Fill grid_a

	movi r1 grid_b
	sw r1 [r2 + #1]
	movi r1 #2
	sw r1 [r2 + #3] // Fill grid_b

	movi r1 age_grid
	sw r1 [r2 + #1]
	movi r1 #2
	sw r1 [r2 + #3] // Fill age_grid
	ret

// =============================================================================
// Subroutine: seed_grid()
// =============================================================================
seed_grid:
	push r7
	push r4
	push r5
	push r1

	call clear_grids

	movi r4 grid_a
	addi r4 r4 #32
	addi r4 r4 #33
	movi r5 #1

	.seed_y_loop:
		movi r1 #63
		beq r5 r1 .seed_done

		movi r1 #62
		mov r2 r4
		movi r3 0x2000
		call random_weighted_array

		addi r4 r4 #32
		addi r4 r4 #32
		addi r5 r5 #1
		beq r0 r0 .seed_y_loop

	.seed_done:
		pop r1
		pop r5
		pop r4
		pop r7
		ret

// =============================================================================
// Subroutine: update_age_grid(r1 = new_generation, r2 = age_grid)
// Iterates exactly 4096 times. Guarantees ages are bounded between -7 and 8.
// =============================================================================
update_age_grid:
	push r7
	push r4
	push r5
	push r3

	mov r4 r1 // active_grid
	mov r5 r2 // age_grid
	movi r3 #4096

	.uag_loop:
		beq r3 r0 .uag_exit_jump
		beq r0 r0 .uag_continue
	.uag_exit_jump:
		movi r7 .uag_done
		jalr r0 r7 #0

	.uag_continue:
		lw r1 [r4 + #0] // cell state (0 or 1)
		lw r2 [r5 + #0] // age state

		beq r1 r0 .uag_dead

	.uag_alive:
		movi r7 #0
		blt r2 r7 .uag_reset_alive
		beq r2 r0 .uag_reset_alive

		// If already alive, age++
		addi r2 r2 #1
		movi r7 #8
		bgt r2 r7 .uag_cap_alive
		beq r0 r0 .uag_write

	.uag_reset_alive:
		movi r2 #1
		beq r0 r0 .uag_write

	.uag_cap_alive:
		movi r2 #8
		beq r0 r0 .uag_write

	.uag_dead:
		movi r7 #0
		bgt r2 r7 .uag_reset_dead // Just died! -> -1
		beq r2 r0 .uag_write      // Dead forever -> Stay 0

		// Dying trail: age--
		subi r2 r2 #1
		movi r7 #-7
		blt r2 r7 .uag_cap_dead
		beq r0 r0 .uag_write

	.uag_reset_dead:
		movi r2 #-1
		beq r0 r0 .uag_write

	.uag_cap_dead:
		movi r2 #0

	.uag_write:
		sw r2 [r5 + #0]
		addi r4 r4 #1
		addi r5 r5 #1
		subi r3 r3 #1

		movi r7 .uag_loop
		jalr r0 r7 #0

	.uag_done:
		pop r3
		pop r5
		pop r4
		pop r7
		ret

// =============================================================================
// Subroutine: render_grid(r1: ShortArray)
// Pure read-only rendering: draws classic green or age palette without mutating RAM!
// =============================================================================
render_grid:
	push r7
	push r4
	push r5

	movi r2 is_age_mode
	lw r2 [r2 + #0]
	bne r2 r0 .setup_age_mode

	// ---- NORMAL MODE ----
	.setup_normal_mode:
		mov r4 r1
		addi r4 r4 #32
		addi r4 r4 #33
		movi r5 #1
		movi r7 0xFF07
		movi r1 .render_y_loop_normal
		jalr r0 r1 #0

	.render_y_loop_normal:
		movi r1 #63
		bne r5 r1 .continue_y_normal
		movi r1 .render_done
		jalr r0 r1 #0

	.continue_y_normal:
		movi r1 #1
		sw r1 [r7 + #0]
		sw r5 [r7 + #1]
		movi r3 #62
	.render_x_loop_normal:
		beq r3 r0 .render_row_done_normal
		lw r1 [r4 + #0]
		addi r4 r4 #1
		beq r1 r0 .draw_black_normal
	.draw_green_normal:
		movi r2 0x07E0
		sw r2 [r7 + #2]
		beq r0 r0 .next_cell_normal
	.draw_black_normal:
		sw r0 [r7 + #2]
	.next_cell_normal:
		subi r3 r3 #1
		beq r0 r0 .render_x_loop_normal
	.render_row_done_normal:
		addi r4 r4 #2
		addi r5 r5 #1
		movi r1 .render_y_loop_normal
		jalr r0 r1 #0

	// ---- AGE MODE (READ-ONLY, FROZEN WHILE PAUSED) ----
	.setup_age_mode:
		movi r4 age_grid
		addi r4 r4 #32
		addi r4 r4 #33 // r4 = age_grid pointer

		movi r5 #1
		movi r7 0xFF07
		movi r1 .render_y_loop_age
		jalr r0 r1 #0

	.render_y_loop_age:
		movi r1 #63
		bne r5 r1 .continue_y_age
		movi r1 .render_done
		jalr r0 r1 #0

	.continue_y_age:
		movi r1 #1
		sw r1 [r7 + #0]
		sw r5 [r7 + #1]
		movi r3 #62

	.render_x_loop_age:
		beq r3 r0 .render_row_done_age

		// Load Age (-7 to 8)
		lw r1 [r4 + #0]
		addi r4 r4 #1

		// Array Lookup: Shift -7..8 into 0..15
		addi r1 r1 #7
		movi r2 age_palette
		add r2 r2 r1
		lw r2 [r2 + #0] // r2 = Color
		sw r2 [r7 + #2] // Draw to screen

		subi r3 r3 #1
		beq r0 r0 .render_x_loop_age

	.render_row_done_age:
		addi r4 r4 #2
		addi r5 r5 #1
		movi r1 .render_y_loop_age
		jalr r0 r1 #0

	.render_done:
		pop r5
		pop r4
		pop r7
		ret

// =============================================================================
// Subroutine: step_generation(r1 = current, r2 = next)
// =============================================================================
step_generation:
	push r7
	push r4
	push r5

	mov r5 r6
	addi r6 r6 #4
	sw r1 [r5 + #0]
	sw r2 [r5 + #1]
	movi r1 #1
	sw r1 [r5 + #3]

	.row_loop:
		lw r1 [r5 + #3]
		movi r2 #63
		bne r1 r2 .continue_row

		movi r7 .step_done
		jalr r0 r7 #0

	.continue_row:
		mov r3 r1
		add r3 r3 r3
		add r3 r3 r3
		add r3 r3 r3
		add r3 r3 r3
		add r3 r3 r3
		add r3 r3 r3

		lw r1 [r5 + #0]
		add r4 r1 r3
		addi r4 r4 #1

		subi r7 r4 #64

		addi r1 r4 #32
		addi r1 r1 #32

		lw r2 [r5 + #1]
		add r2 r2 r3
		addi r2 r2 #1
		sw r2 [r5 + #2]

		push r1

		movi r3 #62

	.col_loop:
		lw r1 [r7 + #-1]
		lw r2 [r7 + #0]
		add r1 r1 r2
		lw r2 [r7 + #1]
		add r1 r1 r2

		lw r2 [r4 + #-1]
		add r1 r1 r2
		lw r2 [r4 + #1]
		add r1 r1 r2

		lw r2 [r6 + #-1]
		lw r2 [r2 + #-1]
		add r1 r1 r2
		lw r2 [r6 + #-1]
		lw r2 [r2 + #0]
		add r1 r1 r2
		lw r2 [r6 + #-1]
		lw r2 [r2 + #1]
		add r1 r1 r2

		movi r2 pow2_table
		add r2 r2 r1
		lw r2 [r2 + #0]

		lw r1 [r4 + #0]
		beq r1 r0 .check_birth

	.check_survival:
		push r3
		movi r3 rule_survival
		lw r1 [r3 + #0]
		pop r3
		and r1 r1 r2
		bne r1 r0 .cell_alive
		beq r0 r0 .cell_dead

	.check_birth:
		push r3
		movi r3 rule_birth
		lw r1 [r3 + #0]
		pop r3
		and r1 r1 r2
		bne r1 r0 .cell_alive
		beq r0 r0 .cell_dead

	.cell_alive:
		lw r2 [r5 + #2]
		movi r1 #1
		sw r1 [r2 + #0]
		addi r2 r2 #1
		sw r2 [r5 + #2]
		beq r0 r0 .advance_cell

	.cell_dead:
		lw r2 [r5 + #2]
		sw r0 [r2 + #0]
		addi r2 r2 #1
		sw r2 [r5 + #2]

	.advance_cell:
		addi r7 r7 #1
		addi r4 r4 #1

		lw r2 [r6 + #-1]
		addi r2 r2 #1
		sw r2 [r6 + #-1]

		subi r3 r3 #1

		beq r3 r0 .row_finished
		movi r1 .col_loop
		jalr r0 r1 #0

	.row_finished:
		pop r1
		lw r1 [r5 + #3]
		addi r1 r1 #1
		sw r1 [r5 + #3]
		movi r7 .row_loop
		jalr r0 r7 #0

	.step_done:
		subi r6 r6 #4
		pop r5
		pop r4
		pop r7
		ret

// =============================================================================
// Subroutine: parse_rule_string
// =============================================================================
parse_rule_string:
	push r7
	push r4
	push r5

	mov r4 r1
	movi r5 rule_birth

	movi r2 rule_birth
	sw r0 [r2 + #0]
	movi r2 rule_survival
	sw r0 [r2 + #0]

	.parse_loop:
		lw r1 [r4 + #0]
		bne r1 r0 .continue_parse
		movi r7 .parse_done
		jalr r0 r7 #0

	.continue_parse:
		addi r4 r4 #1

		movi r2 #48
		blt r1 r2 .check_letters
		movi r2 #56
		bgt r1 r2 .check_letters

		subi r1 r1 #48
		movi r2 pow2_table
		add r2 r2 r1
		lw r2 [r2 + #0]
		lw r3 [r5 + #0]
		or r3 r3 r2
		sw r3 [r5 + #0]

		movi r7 .parse_loop
		jalr r0 r7 #0

	.check_letters:
		movi r2 #66
		beq r1 r2 .set_mode_birth
		movi r2 #98
		beq r1 r2 .set_mode_birth

		movi r2 #83
		beq r1 r2 .set_mode_survival
		movi r2 #115
		beq r1 r2 .set_mode_survival

		movi r7 .parse_loop
		jalr r0 r7 #0

	.set_mode_birth:
		movi r5 rule_birth
		movi r7 .parse_loop
		jalr r0 r7 #0

	.set_mode_survival:
		movi r5 rule_survival
		movi r7 .parse_loop
		jalr r0 r7 #0

	.parse_done:
		pop r5
		pop r4
		pop r7
		ret

// =============================================================================
// DATA SECTION
// =============================================================================
rule_pointer:           .fill rule_conway

rule_replicator:        .fill "B1357/S1357"
rule_seeds:             .fill "B2/S"
rule_life_without_death:.fill "B3/S012345678"
rule_conway:            .fill "B3/S23"
rule_34_life:           .fill "B34/S34"
rule_diamoeba:          .fill "B35678/S5678"
rule_2x2:               .fill "B36/S125"
rule_highlife:          .fill "B36/S23"
rule_day_night:         .fill "B3678/S34678"
rule_morley:            .fill "B368/S245"
rule_anneal:            .fill "B4678/S35678"

age_palette:
	.fill { 0x1082 0x2104 0x3186 0x4208 0x630C 0x8410 0xA514 }
	.fill { 0x0000 }
	.fill { 0xFFFF 0xFFE0 0xFD20 0x07E0 0x07FF 0x001F 0x801F 0xF81F }

// =============================================================================
// Stamp Roster Table
// =============================================================================
current_stamp_idx: .fill 0
NUM_STAMPS:        .fill 4
show_ghost:        .fill 0 // 0 = OFF (Default), 1 = ON

stamp_roster:
	.fill stamp_glider
	.fill stamp_lwss
	.fill stamp_pulsar
	.fill sprite_alien

// Pattern 0: Glider (Flies diagonally down-right)
stamp_glider:
	.fill { 0 1 0 0 0 0 0 0 }
	.fill { 0 0 1 0 0 0 0 0 }
	.fill { 1 1 1 0 0 0 0 0 }
	.fill { 0 0 0 0 0 0 0 0 }
	.fill { 0 0 0 0 0 0 0 0 }
	.fill { 0 0 0 0 0 0 0 0 }
	.fill { 0 0 0 0 0 0 0 0 }
	.fill { 0 0 0 0 0 0 0 0 }

// Pattern 1: Lightweight Spaceship / LWSS (Flies horizontally right)
stamp_lwss:
	.fill { 0 1 0 0 1 0 0 0 }
	.fill { 0 0 0 0 0 1 0 0 }
	.fill { 0 1 0 0 0 1 0 0 }
	.fill { 0 0 1 1 1 1 0 0 }
	.fill { 0 0 0 0 0 0 0 0 }
	.fill { 0 0 0 0 0 0 0 0 }
	.fill { 0 0 0 0 0 0 0 0 }
	.fill { 0 0 0 0 0 0 0 0 }

// Pattern 2: Toad (Oscillator)
stamp_pulsar:
	.fill { 0 0 0 0 0 0 0 0 }
	.fill { 0 0 0 0 0 0 0 0 }
	.fill { 0 0 1 1 1 0 0 0 }
	.fill { 0 1 1 1 0 0 0 0 }
	.fill { 0 0 0 0 0 0 0 0 }
	.fill { 0 0 0 0 0 0 0 0 }
	.fill { 0 0 0 0 0 0 0 0 }
	.fill { 0 0 0 0 0 0 0 0 }

pow2_table:     .fill { 1 2 4 8 16 32 64 128 256 }

is_paused:      .fill 1 // Start paused so you can draw/stamp immediately!
is_age_mode:    .fill 0
cursor_x:       .fill 31
cursor_y:       .fill 31
blink_tick:     .fill 0
prev_gpad:      .fill 0
brush_mode:     .fill 0
prev_e:         .fill 0

rule_birth:     .space 1
rule_survival:  .space 1

grid_a:         .space 4096
grid_b:         .space 4096
age_grid:       .space 4096

stack:          .space 100