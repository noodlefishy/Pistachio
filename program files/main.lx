main:
    movi r6, stack
    call heap_init
	movi r1 1
	call alloc
	mov r5 r1
    mov r1 r5
    movi r2, #30
    call linked_list_insert_at_front

    mov r1 r5
    movi r2, #20
    call linked_list_insert_at_front

    mov r1 r5
    movi r2, #10
    call linked_list_insert_at_front

    mov r1 r5
    lw   r1, [r1 + #0]
    call linked_list_print_list

//    mov r1 r5
//    lw   r1, [r1 + #0]
//    call linked_list_free_list
//
//    mov r1 r5
//	call free

	push r7
    push r4
    push r5

    mov  r4, r5

    // Allocate only 10 words on stack for dynamic itoa_buf
    mov  r5, r6             // r5 = local itoa_buf
    addi r6, r6, 10

	.print_loop:
		beq  r4, r0, .print_null

		// 1. Convert integer into stack itoa_buf
		lw   r1, [r4 + #0]
		mov  r2, r5             // Destination: stack itoa_buf
		call itoa
		call prints

		// 2. Print local arrow literal
		movi r1, .arrow_str
		call prints

		// 3. Next node
		lw   r4, [r4 + #1]
    	beq  r0, r0, .print_loop

	.print_null:
		movi r1, .null_str
		call prints

		// Deallocate stack buffer
		subi r6, r6, 10
		pop  r5
		pop  r4
		pop  r7














    halt


	.arrow_str: .fill " -> "
	.null_str:  .fill "NULL\n"




stack:    .space 100